//=============================================================================
//  car.fx  --  NFS Carbon CarShader + MW daytime lighting
//  GENERATED by make_car.py from the original IDI_CAR_FX.
//
//  VS/PS = original Carbon code (asm). Changes (all scaled by mwDayBlend):
//   - diffuse: night spherical harmonics -> sky/ground ambient + sun*N.L
//     (sun direction = engine rig light 0, car local space)
//   - specular: rig light 0 -> sun colour, fill lights 1/2 dimmed
//   - Carbon fog off in daytime
//   - cubemap reflection reduced (mwCarEnvScale): the daytime cubemap is much brighter
//  Cubemap reflection unchanged (it already renders the daytime world).
//  Loader: CarbonMWVisuals.asi. Annotation <int shader> = original value (REQUIRED).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
shared float     cfMiddleGray : MIDDLE_GRAY;
shared float     cfVisualEffectBrightness : VISUAL_EFFECT_BRIGHTNESS;
float4    cavHarmonicCoeff[10];
shared float4x4  cmWorldView : REG_cmWorldView;
float4x4  cmLocalDirectionMatrix : REG_cmLocalDirectionMatrix;
float4x4  cmLocalColourMatrix : REG_cmLocalColourMatrix;
shared float3    cvLocalEyePos : REG_cvLocalEyePos;
shared float     cfEnvmapPullAmount : REG_cfEnvmapPullAmount;
float4    cvDiffuseMin : REG_cvDiffuseMin;
float4    cvDiffuseRange : REG_cvDiffuseRange;
float4    cvSpecularMin : REG_cvSpecularMin;
float4    cvSpecularRange : REG_cvSpecularRange;
float4    cvEnvmapMin : REG_cvEnvmapMin;
float4    cvEnvmapRange : REG_cvEnvmapRange;
float4    cvPowers : REG_cvPowers;
float4    cvClampAndScales : REG_cvClampAndScales;
float4    cvFlakes : REG_cvFlakes;
float4    cvVinylScales : REG_cvVinylScales;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
texture   MISCMAP1_TEXTURE;
sampler MISCMAP1_SAMPLER = sampler_state
{
    Texture = <MISCMAP1_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   VOLUMEMAP_TEXTURE;
sampler3D VOLUMEMAP_SAMPLER = sampler_state
{
    Texture = <VOLUMEMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    AddressW = WRAP;
    MipFilter = POINT;
    MinFilter = POINT;
    MagFilter = POINT;
};
texture   ENVIROMAP_TEXTURE;
samplerCUBE ENVIROMAP_SAMPLER = sampler_state
{
    Texture = <ENVIROMAP_TEXTURE>;
    AddressU = MIRROR;
    AddressV = MIRROR;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};

shared float4x4 cmWorldMat                 : REG_cmWorldMat;   // ADDED: world position for shadows

//-----------------------------------------------------------------------------
// SUN SHADOWS (set by CarbonMWVisuals.asi every frame; shared through the effect pool)
//   mwShadowParams: x = strength (0 = off), y = mode (1 = hw depth compare D24S8,
//                   2 = manual DF16 compare), z = 1/map size
//-----------------------------------------------------------------------------
shared texture  mwShadowMap;
shared float4x4 mwShadowTransform;
shared float4   mwShadowParams = float4(0.0, 1.0, 0.0009765625, 0.0);
shared int      mwShadowFilter = 2;   // 2 = LINEAR (hw 2x2 PCF), 1 = POINT (DF16)
shared float4   mwShadowParams2 = float4(0.0, 1.0, 0.0, 0.0);   // x = darken ambient in shadow, y = PCF radius (texels)

float  mwShadowStrength   = 1.0;      // strength multiplier for this shader (main strength: Strength in CarbonMWVisuals.ini)
float  mwShadowBias       = 0.0025;   // ~1.6 m: skips the car's own shadow (roof/mirrors/cabin, < 1.6 m from the body);
                                     // shadows of trees/poles/buildings (higher up) still fall on the body. 1 m ~ 0.00155. Raise it if you see shadow acne, lower it if shadows detach from the base of objects
float  mwShadowSoftness   = 1.0;      // PCF radius multiplier (main radius: Softness in CarbonMWVisuals.ini)

sampler mwShadowSampler = sampler_state
{
    Texture   = <mwShadowMap>;
    MinFilter = <mwShadowFilter>;
    MagFilter = <mwShadowFilter>;
    MipFilter = NONE;
    AddressU  = BORDER;
    AddressV  = BORDER;
    BorderColor = 0xFFFFFFFF;
};


//-----------------------------------------------------------------------------
// MW DAYTIME PARAMETERS (defaults; the Carbon engine never touches these). Z = up.
// Same values in every port shader (world/worldreflect/worldnormalmap/worldprelit).
//-----------------------------------------------------------------------------
float  mwDayBlend         = 1.0;    // 0 = original Carbon shading (night), 1 = full MW daytime
float  mwSunSource        = 0.0;    // 0 = mwSunDirection, 1 = cvLocalLightVec from the engine
float3 mwSunDirection     = float3(0.35, 0.45, 0.82);   // direction TO the sun (world space)
float4 mwDiffuseColour    = float4(0.62, 0.57, 0.48, 1.0);
float4 mwAmbientColour    = float4(0.36, 0.38, 0.42, 1.0);
float3 mwBetaRayleigh     = float3(0.000107, 0.000179, 0.000373);
float3 mwBetaMie          = float3(0.000040, 0.000052, 0.000079);
float  mwMieG             = -0.50;
float  mwInscatterIntensity = 8.1;
float  mwFogDistanceScale = 1.0;
float3 mwInscatterTint    = float3(1.0, 1.0, 1.0);
float  mwSunExtinction    = 0.0;
float  mwBakedLightMix    = 0.0;    // 0 = drop the baked night lights, 1 = use them as they are
float  mwBakedAOStrength  = 0.5;
float  mwBakedAOScale     = 2.0;
float  mwCarbonFogMix     = 0.0;

static const float3 LUMINANCE = float3(0.2125, 0.7154, 0.0721);
static const float  PI        = 3.14159265;


//-----------------------------------------------------------------------------
// Car parameters (daytime)
//-----------------------------------------------------------------------------
float  mwCarSunScale      = 0.8;    // sun strength on paint diffuse
float  mwCarSkyScale      = 1.1;    // ambient from above (sky)
float  mwCarGroundScale   = 0.7;    // ambient from below (road bounce)
float  mwCarSunSpecScale  = 1.0;    // sun specular highlight strength
float  mwCarFillScale     = 0.1;    // rig fill lights (night street lights) in daytime
float  mwCarWorldSun      = 1.0;    // 1 = car sun direction = world sun (same as the shadows),
                                    // 0 = Carbon car light rig (changes per region, e.g. after a canyon race)
float  mwCarEnvScale      = 0.13;   // cubemap reflection strength in daytime. Material reflection strengths
                                    // (cvEnvmapMin/Range) were tuned by EA for the dark NIGHT cubemap;
                                    // the daytime cubemap is 3-4x brighter -> without this paint looks like "chrome".
// == Daytime clearcoat (so saturated paints do not look like a "night material")
float  mwCarEnvRimScale   = 0.4;    // cubemap reflection at grazing angles (Fresnel). Head-on stays mwCarEnvScale
float  mwCarEnvNeutral    = 0.6;    // 0 = reflection tinted by the paint (Carbon), 1 = clear/neutral (clearcoat)
float  mwCarSpecWhite     = 0.8;    // 0 = sun highlight tinted by the paint (Carbon), 1 = white (clearcoat)
float  mwCarDiffuseDesat  = 0.25;   // reduce paint (diffuse) saturation in daytime, 0 = original
// == Head/brake light glass (materials HEADLIGHTGLASS/BRAKELIGHTGLASS: cubemap reflection 3-10x paint,
//    detected automatically: specular 0, opaque, high minimum reflection. Window glass is not affected.)
float  mwCarGlassEnvScale = 0.04;   // light glass reflection in daytime, head-on (replaces mwCarEnvScale)
float  mwCarGlassRimScale = 0.15;   // light glass reflection at grazing angles (replaces mwCarEnvRimScale)
float  mwCarGlassDebug    = 0;      // 1 = light glass reflections turn purple (shows which parts count as light glass; needs DebugMode=1)
// == Shadows on the car body (cars are casters too -> self-shadowing is prone to acne/blotches)
float  mwCarShadowNormalOffset = 0.10;  // move the shadow sample point along the normal (m). Raise it if blotches remain
float  mwCarShadowFadeStart    = 0.10;  // sun N.L below this: the body receives no shadow (it is already dark)
float  mwCarShadowFadeWidth    = 0.25;  // N.L transition to full shadow

//-----------------------------------------------------------------------------
// Techniques: same order & annotations as the original
//-----------------------------------------------------------------------------
technique car < int shader = 3; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_3_0
            def c28, -0.25, 1.20000005, 0.0399999991, 0
            def c29, 20, 1, 0.100000001, -0.600000024
            def c30, -0.75, 1, 0, 0
            def c31, 0.212500006, 0.715399981, 0.0720999986, 0
            dcl_position v0
            dcl_normal v1
            dcl_texcoord v2
            dcl_position o0
            dcl_color o1
            dcl_color1 o2
            dcl_texcoord o3
            dcl_texcoord1 o4
            dcl_texcoord2 o5
            dcl_texcoord3 o6
            dcl_texcoord4 o7
            dcl_fog o8.x
            dcl_texcoord5 o9.xyz
            dp4 o0.x, v0, c10
            dp4 o0.y, v0, c11
            dp4 o0.w, v0, c13
            dp4 r0.y, v0, c12
            mul o7.xyz, c29.x, v0
            add r0.w, -r0.y, c17.x
            mov o0.z, r0.y
            mul_sat r0.w, r0.w, c17.y
            add r0.w, -r0.w, c29.y
            add r0.xyz, c19, -v0
            pow r1.w, r0.w, c17.w
            dp3 r0.w, r0, r0
            mul r1.w, r1.w, c17.z
            rsq r0.w, r0.w
            mov r1.z, c29.y
            mad r5.x, r1.w, -c18.x, r1.z
            add r5.y, -r5.x, c29.y                 // MW: 1 - fog
            mad o8.x, c37.x, r5.y, r5.x            // MW: lerp(fog, 1, dayBlend): fog off in daytime
            mul r0.xyz, r0, r0.w
            rcp r0.w, r0.w
            dp3 r1.w, -r0, v1
            mad o4.w, r1.w, c29.z, c29.w
            mad_sat r0.w, r0.w, c28.x, c28.y
            mul r0.w, r0.w, c27.y
            dp3 r1.w, r0, v1
            mul o5.w, r0.w, c28.z
            slt r0.w, r1.w, c28.w
            mad o3.w, r0.w, c30.x, c30.y
            add r0.w, r1_abs.w, r1_abs.w
            mov_sat r2.w, r1.w
            mad r1.xyz, r0.w, -v1, r0
            mov o5.xyz, r0
            mov r1.xyz, -r1
            mad r1.w, c20.x, -r1.z, r1.z
            mul r0, v1.xyzy, v1.xyzx
            nrm r2.xyz, r1.xyww
            mov r1.xyz, c1
            mad r1.xyz, r1, r0.x, c0
            dp3 o3.x, r2, c14
            mad r1.xyz, c2, r0.y, r1
            dp3 o3.y, r2, c15
            mad r0.xyz, c3, r0.z, r1
            dp3 o3.z, r2, c16
            mad r0.xyz, c4, r0.w, r0
            mul r2.xy, v1.xzzw, v1.zyzw
            log r0.w, r2.w
            mad r0.xyz, c5, r2.x, r0
            mul r1.xy, r0.w, c25.xzzw
            mad r0.xyz, c6, r2.y, r0
            exp r1.x, r1.x
            exp r1.y, r1.y
            mad r0.xyz, c7, v1.x, r0
            min r1.xy, r1, c26
            mad r0.xyz, c8, v1.y, r0
            mul r2.xy, r1, c26.zwzw
            mad_sat r1.xyz, c9, v1.z, r0
            dp3_sat r3.x, v1, c32                  // MW: sun N.L
            mad r3.y, v1.z, c36.y, c36.y           // MW: hemisphere (0 = below, 1 = above)
            mov r5.xyz, c35                        // MW: ground ambient
            lrp r4.xyz, r3.y, c34, r5              // MW: sky/ground ambient
            mad r4.xyz, r3.x, c33, r4              // MW: + sun
            lrp r5.xyz, c36.x, r4, r1              // MW: blend night SH -> day
            mov r1.xyz, r5
            mul r4.xyz, r3.x, c33                  // MW shadow: sun irradiance
            mul r4.xyz, r4, c36.x
            dp3 r4.x, r4, c31
            dp3 r4.y, r1, c31
            max r4.y, r4.y, c28.z
            rcp r4.y, r4.y
            mul_sat o7.w, r4.x, r4.y               // MW shadow: sun share of the diffuse light
            dp3 r4.x, v1, c39                      // MW shadow: normal world
            dp3 r4.y, v1, c40
            dp3 r4.z, v1, c41
            nrm r3.xyz, r4
            dp4 r5.x, v0, c39                      // MW shadow: world position
            dp4 r5.y, v0, c40
            dp4 r5.z, v0, c41
            mad o9.xyz, r3, c43.x, r5              // MW shadow: normal offset (against acne/blotches)
            mov r0, c22
            mad r0, r2.x, r0, c21
            mul o1.xyz, r1, r0
            dp3 r1.w, c31, r1
            mov o1.w, r0.w
            mad r0.w, r2.x, c27.w, c27.z
            mov r0.xyz, c24
            mad r4.xyz, r2.y, r0, c23
            add r3.z, -r2.w, c29.y                 // MW clearcoat: 1 - N.V
            mul r3.w, r3.z, r3.z
            mul r3.w, r3.w, r3.w
            mul r3.w, r3.w, r3.z                   // Fresnel (1 - N.V)^5
            mad r3.w, r3.w, c38.y, c38.x           // reflection scale: head-on -> grazing angle
            dp3 r3.x, r4, c31
            lrp r5.xyz, c42.x, r3.x, r4            // MW clearcoat: reflection colour -> neutral
            mul r5.xyz, r5, r3.w
            lrp r4.xyz, c44.w, c44, r5             // MW light glass debug (mwCarGlassDebug); LRP dest must be r#
            mov o2.xyz, r4
            mul o2.w, r1.w, r0.w
            mov o4.xyz, v2
            mov o6, v1
        };
        VertexShaderConstantF[10] = float4(WorldViewProj._m00, WorldViewProj._m10, WorldViewProj._m20, WorldViewProj._m30);
        VertexShaderConstantF[11] = float4(WorldViewProj._m01, WorldViewProj._m11, WorldViewProj._m21, WorldViewProj._m31);
        VertexShaderConstantF[12] = float4(WorldViewProj._m02, WorldViewProj._m12, WorldViewProj._m22, WorldViewProj._m32);
        VertexShaderConstantF[13] = float4(WorldViewProj._m03, WorldViewProj._m13, WorldViewProj._m23, WorldViewProj._m33);
        VertexShaderConstantF[0] = (cavHarmonicCoeff[0]);
        VertexShaderConstantF[1] = (cavHarmonicCoeff[1]);
        VertexShaderConstantF[2] = (cavHarmonicCoeff[2]);
        VertexShaderConstantF[3] = (cavHarmonicCoeff[3]);
        VertexShaderConstantF[4] = (cavHarmonicCoeff[4]);
        VertexShaderConstantF[5] = (cavHarmonicCoeff[5]);
        VertexShaderConstantF[6] = (cavHarmonicCoeff[6]);
        VertexShaderConstantF[7] = (cavHarmonicCoeff[7]);
        VertexShaderConstantF[8] = (cavHarmonicCoeff[8]);
        VertexShaderConstantF[9] = (cavHarmonicCoeff[9]);
        VertexShaderConstantF[20] = float4(cfEnvmapPullAmount, 0, 0, 0);
        VertexShaderConstantF[18] = float4(cfFogEnable, 0, 0, 0);
        VertexShaderConstantF[14] = float4(cmWorldView._m00, cmWorldView._m10, cmWorldView._m20, cmWorldView._m30);
        VertexShaderConstantF[15] = float4(cmWorldView._m01, cmWorldView._m11, cmWorldView._m21, cmWorldView._m31);
        VertexShaderConstantF[16] = float4(cmWorldView._m02, cmWorldView._m12, cmWorldView._m22, cmWorldView._m32);
        VertexShaderConstantF[26] = (cvClampAndScales);
        VertexShaderConstantF[21] = (cvDiffuseMin);
        VertexShaderConstantF[22] = (cvDiffuseRange);
        VertexShaderConstantF[23] = (cvEnvmapMin);
        VertexShaderConstantF[24] = (cvEnvmapRange);
        VertexShaderConstantF[27] = (cvFlakes);
        VertexShaderConstantF[17] = (cvFogValue);
        VertexShaderConstantF[19] = float4(cvLocalEyePos, 0);
        VertexShaderConstantF[25] = (cvPowers);
        VertexShaderConstantF[32] = float4(lerp(cmLocalDirectionMatrix._m00, dot(float3(cmWorldMat._11, cmWorldMat._12, cmWorldMat._13), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), lerp(cmLocalDirectionMatrix._m10, dot(float3(cmWorldMat._21, cmWorldMat._22, cmWorldMat._23), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), lerp(cmLocalDirectionMatrix._m20, dot(float3(cmWorldMat._31, cmWorldMat._32, cmWorldMat._33), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), 0);   // MW: sun direction, car local space
        VertexShaderConstantF[33] = float4(mwDiffuseColour.rgb * mwCarSunScale, 0);
        VertexShaderConstantF[34] = float4(mwAmbientColour.rgb * mwAmbientColour.w * mwCarSkyScale, 0);
        VertexShaderConstantF[35] = float4(mwAmbientColour.rgb * mwAmbientColour.w * mwCarGroundScale, 0);
        VertexShaderConstantF[36] = float4(mwDayBlend, 0.5, 0, 0);
        VertexShaderConstantF[37] = float4(mwDayBlend * (1.0 - mwCarbonFogMix), 0, 0, 0);
        VertexShaderConstantF[38] = float4(lerp(1.0, lerp(mwCarEnvScale, mwCarGlassEnvScale, (saturate(1.0 - 1000.0 * (dot(cvSpecularMin.xyz, cvSpecularMin.xyz) + dot(cvSpecularRange.xyz, cvSpecularRange.xyz))) * saturate((cvDiffuseMin.w - 0.98) * 50.0) * saturate((cvEnvmapMin.x - 1.1) * 7.0))), mwDayBlend), mwDayBlend * (lerp(mwCarEnvRimScale, mwCarGlassRimScale, (saturate(1.0 - 1000.0 * (dot(cvSpecularMin.xyz, cvSpecularMin.xyz) + dot(cvSpecularRange.xyz, cvSpecularRange.xyz))) * saturate((cvDiffuseMin.w - 0.98) * 50.0) * saturate((cvEnvmapMin.x - 1.1) * 7.0))) - lerp(mwCarEnvScale, mwCarGlassEnvScale, (saturate(1.0 - 1000.0 * (dot(cvSpecularMin.xyz, cvSpecularMin.xyz) + dot(cvSpecularRange.xyz, cvSpecularRange.xyz))) * saturate((cvDiffuseMin.w - 0.98) * 50.0) * saturate((cvEnvmapMin.x - 1.1) * 7.0)))), 0, 0);   // MW: reflection scale (paint / light glass)
        VertexShaderConstantF[39] = float4(cmWorldMat._11, cmWorldMat._21, cmWorldMat._31, cmWorldMat._41);   // MW shadow: cmWorldMat column 1
        VertexShaderConstantF[40] = float4(cmWorldMat._12, cmWorldMat._22, cmWorldMat._32, cmWorldMat._42);   // MW shadow: cmWorldMat column 2
        VertexShaderConstantF[41] = float4(cmWorldMat._13, cmWorldMat._23, cmWorldMat._33, cmWorldMat._43);   // MW shadow: cmWorldMat column 3
        VertexShaderConstantF[42] = float4(mwCarEnvNeutral * mwDayBlend, 0, 0, 0);   // MW clearcoat
        VertexShaderConstantF[43] = float4(mwCarShadowNormalOffset, 0, 0, 0);   // MW shadow
        VertexShaderConstantF[44] = float4(3.0, 0, 3.0, saturate(mwCarGlassDebug) * (saturate(1.0 - 1000.0 * (dot(cvSpecularMin.xyz, cvSpecularMin.xyz) + dot(cvSpecularRange.xyz, cvSpecularRange.xyz))) * saturate((cvDiffuseMin.w - 0.98) * 50.0) * saturate((cvEnvmapMin.x - 1.1) * 7.0)));   // MW light glass debug
        PixelShader = asm
        {
            ps_3_0
            def c207, 1, 0, 0.0625, 0
            def c208, -40, 1, 0, 0.001
            def c11, 1, -0, -3, -0.5
            def c12, 2, 0, 0, 0
            dcl_color_pp v1
            dcl_color1_pp v2
            dcl_texcoord_pp v3
            dcl_texcoord1_pp v4
            dcl_texcoord2_pp v5
            dcl_texcoord3_pp v6.xyz
            dcl_texcoord4_pp v7
            dcl_fog_pp v8.x
            dcl_2d s0
            dcl_volume s1
            dcl_cube s2
            dcl_texcoord5 v0.xyz
            dcl_2d s8
            mov r24.xyz, v0                  // MW shadow: world position
            mov r24.w, c207.x
            dp4 r25.x, r24, c200
            dp4 r25.y, r24, c201
            dp4 r25.z, r24, c202
            dp4 r25.w, r24, c203
            add r28.y, r25.w, -c208.w              // MW shadow: w <= 0 -> outside the map
            cmp r28.y, r28.y, c207.y, c207.x
            max r25.w, r25.w, c208.w
            rcp r25.w, r25.w
            mul r24.xyz, r25, r25.w              // MW shadow: shadow map coordinates
            add r24.z, r24.z, -c206.x             // MW shadow: - bias
            mov r24.w, c207.x
            mov r25.zw, r24                     // MW shadow: tap group 0
            add r25.xy, r24, c211
            texldp r26, r25, s8
            add r25.xy, r24, c211.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c212
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c212.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r28.w, r25, c207.z
            mov r25.zw, r24                     // MW shadow: tap group 1
            add r25.xy, r24, c213
            texldp r26, r25, s8
            add r25.xy, r24, c213.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c214
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c214.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.zw, r24                     // MW shadow: tap group 2
            add r25.xy, r24, c215
            texldp r26, r25, s8
            add r25.xy, r24, c215.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c216
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c216.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.zw, r24                     // MW shadow: tap group 3
            add r25.xy, r24, c217
            texldp r26, r25, s8
            add r25.xy, r24, c217.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c218
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c218.zwzw
