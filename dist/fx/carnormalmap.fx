//=============================================================================
//  carnormalmap.fx  --  NFS Carbon CarNormalMap (light glass, normal-mapped parts) + MW daytime
//  GENERATED by make_carnormalmap.py from the original IDI_CARNORMALMAP_FX.
//
//  VS/PS = original Carbon code (asm). Daytime (mwDayBlend):
//   - diffuse: night SH -> sky/ground ambient + sun*N.L (same as car.fx)
//   - cubemap reflection reduced: head-on mwCarGlassEnvScale, grazing mwCarGlassRimScale
//   - specular: rig light 0 -> sun (white), night fill lights dimmed
//   - Carbon fog off
//  Loader: CarbonMWVisuals.asi. Annotation <int shader> = original value (REQUIRED).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
float4    cavHarmonicCoeff[10];
shared float4x4  cmWorldView : REG_cmWorldView;
float4x4  cmLocalDirectionMatrix : REG_cmLocalDirectionMatrix;
float4x4  cmLocalColourMatrix : REG_cmLocalColourMatrix;
shared float3    cvLocalEyePos : REG_cvLocalEyePos;
shared float     cfEnvmapPullAmount : REG_cfEnvmapPullAmount;
float4    cvDiffuseMin : REG_cvDiffuseMin;
float4    cvDiffuseRange : REG_cvDiffuseRange;
float4    cvSpecularMin : REG_cvSpecularMin;
float4    cvSpecularRange : REG_cvSpecularRange;
float4    cvEnvmapMin : REG_cvEnvmapMin;
float4    cvEnvmapRange : REG_cvEnvmapRange;
float4    cvPowers : REG_cvPowers;
float4    cvClampAndScales : REG_cvClampAndScales;
float4    cvFlakes : REG_cvFlakes;
float4    cvVinylScales : REG_cvVinylScales;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   NORMALMAP_TEXTURE;
sampler NORMALMAP_SAMPLER = sampler_state
{
    Texture = <NORMALMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   VOLUMEMAP_TEXTURE;
sampler3D VOLUMEMAP_SAMPLER = sampler_state
{
    Texture = <VOLUMEMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    AddressW = WRAP;
    MipFilter = POINT;
    MinFilter = POINT;
    MagFilter = POINT;
};
texture   ENVIROMAP_TEXTURE;
samplerCUBE ENVIROMAP_SAMPLER = sampler_state
{
    Texture = <ENVIROMAP_TEXTURE>;
    AddressU = MIRROR;
    AddressV = MIRROR;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
shared float4x4 cmWorldMat                 : REG_cmWorldMat;   // ADDED: sun direction into car local space


//-----------------------------------------------------------------------------
// MW DAYTIME PARAMETERS (defaults; the Carbon engine never touches these). Z = up.
// Same values in every port shader (world/worldreflect/worldnormalmap/worldprelit).
//-----------------------------------------------------------------------------
float  mwDayBlend         = 1.0;    // 0 = original Carbon shading (night), 1 = full MW daytime
float  mwSunSource        = 0.0;    // 0 = mwSunDirection, 1 = cvLocalLightVec from the engine
float3 mwSunDirection     = float3(0.35, 0.45, 0.82);   // direction TO the sun (world space)
float4 mwDiffuseColour    = float4(0.62, 0.57, 0.48, 1.0);
float4 mwAmbientColour    = float4(0.36, 0.38, 0.42, 1.0);
float3 mwBetaRayleigh     = float3(0.000107, 0.000179, 0.000373);
float3 mwBetaMie          = float3(0.000040, 0.000052, 0.000079);
float  mwMieG             = -0.50;
float  mwInscatterIntensity = 8.1;
float  mwFogDistanceScale = 1.0;
float3 mwInscatterTint    = float3(1.0, 1.0, 1.0);
float  mwSunExtinction    = 0.0;
float  mwBakedLightMix    = 0.0;    // 0 = drop the baked night lights, 1 = use them as they are
float  mwBakedAOStrength  = 0.5;
float  mwBakedAOScale     = 2.0;
float  mwCarbonFogMix     = 0.0;

static const float3 LUMINANCE = float3(0.2125, 0.7154, 0.0721);
static const float  PI        = 3.14159265;


//-----------------------------------------------------------------------------
// Parameters (daytime). mwCar*Scale = same as car.fx (copied by the generator).
//-----------------------------------------------------------------------------
float  mwCarSunScale      = 0.8;
float  mwCarSkyScale      = 1.1;
float  mwCarGroundScale   = 0.7;
float  mwCarSunSpecScale  = 1.0;
float  mwCarFillScale     = 0.1;
float  mwCarWorldSun      = 1.0;    // 1 = car sun direction = world sun (same as the shadows),
                                    // 0 = Carbon car light rig (changes per region, e.g. after a canyon race)
// == Light glass / normal-mapped parts
float  mwCarGlassEnvScale  = 0.25;  // cubemap reflection strength in daytime, head-on (1 = like at night)
float  mwCarGlassRimScale  = 0.5;   // reflection strength at grazing angles (Fresnel)
float  mwCarGlassSpecScale = 0.8;   // sun highlight strength on light glass (x mwCarSunSpecScale)

//-----------------------------------------------------------------------------
// Techniques: same order & annotations as the original
//-----------------------------------------------------------------------------
technique car_normalmap < int shader = 3; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_3_0
            def c28, 20, 1, 0.100000001, -1.20000005
            def c29, -0.25, 1.20000005, 0.0399999991, 0
            def c30, 0.212500006, 0.715399981, 0.0720999986, 0
            dcl_position v0
            dcl_normal v1
            dcl_texcoord v2
            dcl_tangent v3
            dcl_position o0
            dcl_color o1
            dcl_color1 o2
            dcl_texcoord o3
            dcl_texcoord1 o4
            dcl_texcoord2 o5
            dcl_texcoord3 o6
            dcl_texcoord4 o7.xyz
            dcl_texcoord5 o8
            dcl_fog o9.x
            dp4 o0.x, v0, c10
            dp4 o0.y, v0, c11
            dp4 o0.w, v0, c13
            dp4 r0.y, v0, c12
            mul o7.xyz, c28.x, v0
            add r0.w, -r0.y, c17.x
            mov o0.z, r0.y
            mul_sat r0.w, r0.w, c17.y
            add r1.w, -r0.w, c28.y
            add r0.xyz, c19, -v0
            pow r0.w, r1.w, c17.w
            nrm r2.xyz, r0
            mul r0.z, r0.w, c17.z
            dp3 r0.w, r2, r2
            mov r0.y, c28.y
            mad r6.x, r0.z, -c18.x, r0.y
            add r6.y, -r6.x, c35.z                 // MW: 1 - fog
            mad o9.x, c36.x, r6.y, r6.x            // MW: fog off in daytime
            rsq r0.z, r0.w
            dp3 r0.w, -r2, v1
            rcp r0.z, r0.z
            mad o4.w, r0.w, c28.z, c28.w
            mad_sat r0.z, r0.z, c29.x, c29.y
            add r0.w, r0.w, r0.w
            mul r0.z, r0.z, c27.y
            mul o5.w, r0.z, c29.z
            mad r1.xyz, v1, -r0.w, -r2
            mad r1.w, c20.x, -r1.z, r1.z
            mul r0, v1.xyzy, v1.xyzx
            nrm r3.xyz, r1.xyww
            mov r1.xyz, c1
            mad r1.xyz, r1, r0.x, c0
            dp3 o3.x, r3, c14
            mad r1.xyz, c2, r0.y, r1
            dp3 o3.y, r3, c15
            mad r0.xyz, c3, r0.z, r1
            dp3 o3.z, r3, c16
            mad r0.xyz, c4, r0.w, r0
            mul r1.xy, v1.xzzw, v1.zyzw
            dp3_sat r0.w, r2, v1
            mad r0.xyz, c5, r1.x, r0
            log r0.w, r0.w
            mad r0.xyz, c6, r1.y, r0
            mul r1.xy, r0.w, c25.xzzw
            mad r0.xyz, c7, v1.x, r0
            exp r1.x, r1.x
            exp r1.y, r1.y
            mad r0.xyz, c8, v1.y, r0
            min r3.xy, r1, c26
            mad r1.xyz, c9, v1.z, r0
            dp3_sat r4.x, v1, c31                  // MW: sun N.L
            mad r4.y, v1.z, c35.y, c35.y           // MW: hemisphere (0 = below, 1 = above)
            mov r6.xyz, c34                        // MW: ground ambient
            lrp r5.xyz, r4.y, c33, r6              // MW: sky/ground ambient
            mad r5.xyz, r4.x, c32, r5              // MW: + sun
            lrp r6.xyz, c35.x, r5, r1              // MW: blend night SH -> day
            mov r1.xyz, r6
            mul r3.xy, r3, c26.zwzw
            mov o5.xyz, r2
            mov r0, c22
            mad r0, r3.x, r0, c21
            mul o1.xyz, r1, r0
            dp3 r1.w, c30, r1
            mov o1.w, r0.w
            mad r0.w, r3.x, c27.w, c27.z
            mov r0.xyz, c24
            mad r5.xyz, r3.y, r0, c23
            dp3_sat r6.w, r2, v1                   // MW: N.V (r2 = direction to the eye)
            add r6.z, -r6.w, c35.z                 // 1 - N.V
            mul r6.w, r6.z, r6.z
            mul r6.w, r6.w, r6.w
            mul r6.w, r6.w, r6.z                   // Fresnel (1 - N.V)^5
            mad r6.w, r6.w, c37.y, c37.x           // MW: daytime reflection scale (head-on -> grazing)
            mul o2.xyz, r5, r6.w
            mul o2.w, r1.w, r0.w
            mov o3.w, c29.w
            mov o4.xyz, v2
            mov o6, v1
            mov o8, v3
        };
        VertexShaderConstantF[10] = float4(WorldViewProj._m00, WorldViewProj._m10, WorldViewProj._m20, WorldViewProj._m30);
        VertexShaderConstantF[11] = float4(WorldViewProj._m01, WorldViewProj._m11, WorldViewProj._m21, WorldViewProj._m31);
        VertexShaderConstantF[12] = float4(WorldViewProj._m02, WorldViewProj._m12, WorldViewProj._m22, WorldViewProj._m32);
        VertexShaderConstantF[13] = float4(WorldViewProj._m03, WorldViewProj._m13, WorldViewProj._m23, WorldViewProj._m33);
        VertexShaderConstantF[0] = (cavHarmonicCoeff[0]);
        VertexShaderConstantF[1] = (cavHarmonicCoeff[1]);
        VertexShaderConstantF[2] = (cavHarmonicCoeff[2]);
        VertexShaderConstantF[3] = (cavHarmonicCoeff[3]);
        VertexShaderConstantF[4] = (cavHarmonicCoeff[4]);
        VertexShaderConstantF[5] = (cavHarmonicCoeff[5]);
        VertexShaderConstantF[6] = (cavHarmonicCoeff[6]);
        VertexShaderConstantF[7] = (cavHarmonicCoeff[7]);
        VertexShaderConstantF[8] = (cavHarmonicCoeff[8]);
        VertexShaderConstantF[9] = (cavHarmonicCoeff[9]);
        VertexShaderConstantF[20] = float4(cfEnvmapPullAmount, 0, 0, 0);
        VertexShaderConstantF[18] = float4(cfFogEnable, 0, 0, 0);
        VertexShaderConstantF[14] = float4(cmWorldView._m00, cmWorldView._m10, cmWorldView._m20, cmWorldView._m30);
        VertexShaderConstantF[15] = float4(cmWorldView._m01, cmWorldView._m11, cmWorldView._m21, cmWorldView._m31);
        VertexShaderConstantF[16] = float4(cmWorldView._m02, cmWorldView._m12, cmWorldView._m22, cmWorldView._m32);
        VertexShaderConstantF[26] = (cvClampAndScales);
        VertexShaderConstantF[21] = (cvDiffuseMin);
        VertexShaderConstantF[22] = (cvDiffuseRange);
        VertexShaderConstantF[23] = (cvEnvmapMin);
        VertexShaderConstantF[24] = (cvEnvmapRange);
        VertexShaderConstantF[27] = (cvFlakes);
        VertexShaderConstantF[17] = (cvFogValue);
        VertexShaderConstantF[19] = float4(cvLocalEyePos, 0);
        VertexShaderConstantF[25] = (cvPowers);
        VertexShaderConstantF[31] = float4(lerp(cmLocalDirectionMatrix._m00, dot(float3(cmWorldMat._11, cmWorldMat._12, cmWorldMat._13), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), lerp(cmLocalDirectionMatrix._m10, dot(float3(cmWorldMat._21, cmWorldMat._22, cmWorldMat._23), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), lerp(cmLocalDirectionMatrix._m20, dot(float3(cmWorldMat._31, cmWorldMat._32, cmWorldMat._33), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), 0);   // MW: sun direction, car local space
        VertexShaderConstantF[32] = float4(mwDiffuseColour.rgb * mwCarSunScale, 0);
        VertexShaderConstantF[33] = float4(mwAmbientColour.rgb * mwAmbientColour.w * mwCarSkyScale, 0);
        VertexShaderConstantF[34] = float4(mwAmbientColour.rgb * mwAmbientColour.w * mwCarGroundScale, 0);
        VertexShaderConstantF[35] = float4(mwDayBlend, 0.5, 1.0, 0);
        VertexShaderConstantF[36] = float4(mwDayBlend * (1.0 - mwCarbonFogMix), 0, 0, 0);
        VertexShaderConstantF[37] = float4(lerp(1.0, mwCarGlassEnvScale, mwDayBlend), mwDayBlend * (mwCarGlassRimScale - mwCarGlassEnvScale), 0, 0);
        PixelShader = asm
        {
            ps_3_0
            def c11, -0.5, 4, 1, 0.5
            def c12, 1, 0, -3, 2
            dcl_color v1
            dcl_color1_pp v2
            dcl_texcoord_pp v3.xyz
            dcl_texcoord1_pp v4
            dcl_texcoord2_pp v5
            dcl_texcoord3_pp v6.xyz
            dcl_texcoord4_pp v7.xyz
            dcl_texcoord5_pp v8
            dcl_fog_pp v9.x
            dcl_2d s0
            dcl_2d s1
            dcl_volume s2
            dcl_cube s3
            texldb r0, v4, s0
            mov r1.xyz, v1
            add_pp r1.xyz, r1, -v2.w
            mad_pp r2.xyz, c10.x, r1, v2.w
            mul_pp r1.xyz, v1, c11.w
            mad_pp r0.xyz, r2, r0, -r1
            mad_pp r4.xyz, r0.w, r0, r1
            nrm_pp r0.xyz, v3
            texld_pp r1, r0, s3
            nrm_pp r3.xyz, v6
            nrm_pp r0.xyz, v8
            mul_pp r5.xyz, r3.zxyw, r0.yzxw
            texldb_pp r2, v4, s1
            add r6.xy, r2, c11.x
            mad_pp r2.xyz, r3.yzxw, r0.zxyw, -r5
            mul_pp r5.xy, r6, c11.y
            mul_pp r2.xyz, r2, v8.w
            dp2add_pp r1.w, r5, -r5, c11.z
            mul_pp r2.xyz, r5.y, r2
            rsq_pp r1.w, r1.w
            mad_pp r5.xyz, r0, r5.x, r2
            rcp_pp r0.z, r1.w
            mul_pp r1.w, r0.z, c11.w
            mad_pp r2, v7.xyzx, c12.xxxy, c12.yyyz
            texldb_pp r2, r2, s2
            add r0.xyz, r2, c11.x
            mad_pp r2.xyz, r3, r1.w, r5
            mul r0.xyz, r0, v5.w
            mad_pp r2.xyz, c12.w, r0, r2
            nrm_pp r0.xyz, r2
            nrm_pp r2.xyz, v5
            dp3_pp r1.w, -r2, r0
            add_pp r1.w, r1.w, r1.w
            mul_pp r3.xyz, r1, v2
            mad_pp r1.xyz, r0, -r1.w, -r2
            mov r1.w, c12.y
            max r0.xy, c10.yzzw, r1.w
            dp3_sat_pp r0.z, c0, r1
            min r6.xy, r0.w, r0
            pow_pp r1.w, r0.z, c9.y
            mov_pp r0.xyz, c8
            mad_pp r5.xyz, r1.w, r0, c7
            mov_pp r2.x, c3.x
            mov_pp r2.y, c4.x
            mov_pp r2.z, c5.x
            add_pp r6.xy, -r6, c11.z
            mul_pp r2.xyz, r5, r2
            mad_pp r3.xyz, r6.y, r3, r4
            mul_pp r2.xyz, r1.w, r2
            mad_pp r2.xyz, r2, r6.x, r3
            dp3_sat_pp r1.w, c1, r1
            dp3_sat_pp r3.w, c2, r1
            pow_pp r2.w, r1.w, c9.y
            mad_pp r3.xyz, r2.w, r0, c7
            mov_pp r1.x, c3.y
            mov_pp r1.y, c4.y
            mov_pp r1.z, c5.y
            mul_pp r1.xyz, r3, r1
            pow_pp r1.w, r3.w, c9.y
            mad_pp r3.xyz, r1.w, r0, c7
            mov_pp r0.x, c3.z
            mov_pp r0.y, c4.z
            mov_pp r0.z, c5.z
            mul_pp r1.xyz, r2.w, r1
            mul_pp r0.xyz, r3, r0
            mad_pp r1.xyz, r1, r6.x, r2
            mul_pp r0.xyz, r1.w, r0
            mad_pp r0.xyz, r0, r6.x, r1
            add_pp r0.xyz, r0, -c6
            mul_pp oC0.w, r0.w, v1.w
            mad_pp oC0.xyz, v9.x, r0, c6
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[3] = <ENVIROMAP_SAMPLER>;
        Sampler[1] = <NORMALMAP_SAMPLER>;
        Sampler[2] = <VOLUMEMAP_SAMPLER>;
        PixelShaderConstantF[3] = float4(lerp(cmLocalColourMatrix._m00, mwDiffuseColour.r * mwCarSunSpecScale * mwCarGlassSpecScale, mwDayBlend), cmLocalColourMatrix._m10 * lerp(1.0, mwCarFillScale, mwDayBlend), cmLocalColourMatrix._m20 * lerp(1.0, mwCarFillScale, mwDayBlend), cmLocalColourMatrix._m30);
        PixelShaderConstantF[4] = float4(lerp(cmLocalColourMatrix._m01, mwDiffuseColour.g * mwCarSunSpecScale * mwCarGlassSpecScale, mwDayBlend), cmLocalColourMatrix._m11 * lerp(1.0, mwCarFillScale, mwDayBlend), cmLocalColourMatrix._m21 * lerp(1.0, mwCarFillScale, mwDayBlend), cmLocalColourMatrix._m31);
        PixelShaderConstantF[5] = float4(lerp(cmLocalColourMatrix._m02, mwDiffuseColour.b * mwCarSunSpecScale * mwCarGlassSpecScale, mwDayBlend), cmLocalColourMatrix._m12 * lerp(1.0, mwCarFillScale, mwDayBlend), cmLocalColourMatrix._m22 * lerp(1.0, mwCarFillScale, mwDayBlend), cmLocalColourMatrix._m32);
        PixelShaderConstantF[0] = float4(lerp(cmLocalDirectionMatrix._m00, dot(float3(cmWorldMat._11, cmWorldMat._12, cmWorldMat._13), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), lerp(cmLocalDirectionMatrix._m10, dot(float3(cmWorldMat._21, cmWorldMat._22, cmWorldMat._23), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), lerp(cmLocalDirectionMatrix._m20, dot(float3(cmWorldMat._31, cmWorldMat._32, cmWorldMat._33), normalize(mwSunDirection)), saturate(mwCarWorldSun * mwDayBlend)), cmLocalDirectionMatrix._m30);
        PixelShaderConstantF[1] = float4(cmLocalDirectionMatrix._m01, cmLocalDirectionMatrix._m11, cmLocalDirectionMatrix._m21, cmLocalDirectionMatrix._m31);
        PixelShaderConstantF[2] = float4(cmLocalDirectionMatrix._m02, cmLocalDirectionMatrix._m12, cmLocalDirectionMatrix._m22, cmLocalDirectionMatrix._m32);
        PixelShaderConstantF[6] = (cvFogColour);
        PixelShaderConstantF[9] = (cvPowers);
        PixelShaderConstantF[7] = (cvSpecularMin);
        PixelShaderConstantF[8] = (cvSpecularRange);
        PixelShaderConstantF[10] = (cvVinylScales);
    }
}

technique car_normalmap_sm1 < int shader = 1; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_3_0
            def c28, 20, 1, 0.100000001, -1.20000005
            def c29, -0.25, 1.20000005, 0.0399999991, 0
            def c30, 0.212500006, 0.715399981, 0.0720999986, 0
            dcl_position v0
            dcl_normal v1
            dcl_texcoord v2
            dcl_tangent v3
            dcl_position o0
            dcl_color o1
            dcl_color1 o2
            dcl_texcoord o3
            dcl_texcoord1 o4
            dcl_texcoord2 o5
            dcl_texcoord3 o6
            dcl_texcoord4 o7.xyz
            dcl_texcoord5 o8
            dcl_fog o9.x
            dp4 o0.x, v0, c10
            dp4 o0.y, v0, c11
            dp4 o0.w, v0, c13
            dp4 r0.y, v0, c12
            mul o7.xyz, c28.x, v0
            add r0.w, -r0.y, c17.x
            mov o0.z, r0.y
            mul_sat r0.w, r0.w, c17.y
            add r1.w, -r0.w, c28.y
            add r0.xyz, c19, -v0
            pow r0.w, r1.w, c17.w
            nrm r2.xyz, r0
            mul r0.z, r0.w, c17.z
            dp3 r0.w, r2, r2
            mov r0.y, c28.y
            mad r6.x, r0.z, -c18.x, r0.y
            add r6.y, -r6.x, c35.z                 // MW: 1 - fog
            mad o9.x, c36.x, r6.y, r6.x            // MW: fog off in daytime
            rsq r0.z, r0.w
            dp3 r0.w, -r2, v1
            rcp r0.z, r0.z
            mad o4.w, r0.w, c28.z, c28.w
            mad_sat r0.z, r0.z, c29.x, c29.y
            add r0.w, r0.w, r0.w
            mul r0.z, r0.z, c27.y
            mul o5.w, r0.z, c29.z
            mad r1.xyz, v1, -r0.w, -r2
            mad r1.w, c20.x, -r1.z, r1.z
            mul r0, v1.xyzy, v1.xyzx
            nrm r3.xyz, r1.xyww
            mov r1.xyz, c1
            mad r1.xyz, r1, r0.x, c0
            dp3 o3.x, r3, c14
            mad r1.xyz, c2, r0.y, r1
            dp3 o3.y, r3, c15
            mad r0.xyz, c3, r0.z, r1
            dp3 o3.z, r3, c16
            mad r0.xyz, c4, r0.w, r0
            mul r1.xy, v1.xzzw, v1.zyzw
            dp3_sat r0.w, r2, v1
            mad r0.xyz, c5, r1.x, r0
            log r0.w, r0.w
            mad r0.xyz, c6, r1.y, r0
            mul r1.xy, r0.w, c25.xzzw
            mad r0.xyz, c7, v1.x, r0
            exp r1.x, r1.x
            exp r1.y, r1.y
