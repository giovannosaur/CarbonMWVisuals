//=============================================================================
//  sky.fx  --  NFS Carbon SkyShader -> procedural NFS Most Wanted style daytime sky
//  GENERATED by make_sky.py from the original IDI_SKY_FX.
//
//  Sky = midday gradient + MW scattering (same formula & parameters as world,
//  so the horizon blends with the haze on distant objects) + sun glow/disk in the
//  direction mwSunDirection + clouds from Carbon's cloud texture mask (moving via cfTimeTicker).
//  mwDayBlend < 1 -> blends to Carbon's original night sky (ps_3_0 of IDI_SKY_FX, ported to HLSL).
//  Loader: CarbonMWVisuals.asi. Annotation <int shader> = original value (REQUIRED).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
shared float4    cvLocalLightVec : REG_cvLocalLightVec;
shared float4    cvDiffuseColour : REG_cvDiffuseColour;
shared float4    cvCloudIntensity : REG_cvCloudIntensity;
shared float3    cvLocalEyePos : REG_cvLocalEyePos;
shared float     cfTimeTicker : REG_cfTimeTicker;
shared float     cfMipMapBias : REG_cfMipMapBias;
shared float     cfSkyAlphaTag : REG_cfSkyAlphaTag;
shared float4    cfSkyFogFalloff : REG_cfSkyFogFalloff;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = POINT;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   MISCMAP1_TEXTURE;
sampler MISCMAP1_SAMPLER = sampler_state
{
    Texture = <MISCMAP1_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = POINT;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};

//-----------------------------------------------------------------------------
// MW DAYTIME PARAMETERS (defaults; the Carbon engine never touches these). Z = up.
// Same values in every port shader (world/worldreflect/worldnormalmap/worldprelit).
//-----------------------------------------------------------------------------
float  mwDayBlend         = 1.0;    // 0 = original Carbon shading (night), 1 = full MW daytime
float  mwSunSource        = 0.0;    // 0 = mwSunDirection, 1 = cvLocalLightVec from the engine
float3 mwSunDirection     = float3(0.35, 0.45, 0.82);   // direction TO the sun (world space)
float4 mwDiffuseColour    = float4(0.62, 0.57, 0.48, 1.0);
float4 mwAmbientColour    = float4(0.36, 0.38, 0.42, 1.0);
float3 mwBetaRayleigh     = float3(0.000107, 0.000179, 0.000373);
float3 mwBetaMie          = float3(0.000040, 0.000052, 0.000079);
float  mwMieG             = -0.50;
float  mwInscatterIntensity = 8.1;
float  mwFogDistanceScale = 1.0;
float3 mwInscatterTint    = float3(1.0, 1.0, 1.0);
float  mwSunExtinction    = 0.0;
float  mwBakedLightMix    = 0.0;    // 0 = drop the baked night lights, 1 = use them as they are
float  mwBakedAOStrength  = 0.5;
float  mwBakedAOScale     = 2.0;
float  mwCarbonFogMix     = 0.0;

static const float3 LUMINANCE = float3(0.2125, 0.7154, 0.0721);
static const float  PI        = 3.14159265;


// Camera position (object space) from WorldViewProj: the point where clip x = y = w = 0.
// (cvLocalEyePos can be stale because the engine does not always set it for this shader.)
float3 EyeObjectSpace()
{
    float4x4 T = transpose(WorldViewProj);
    float4 a = T[0], b = T[1], c = T[3];
    float3 bc = cross(b.xyz, c.xyz);
    float3 ca = cross(c.xyz, a.xyz);
    float3 ab = cross(a.xyz, b.xyz);
    float  det = dot(a.xyz, bc);
    float3 e = -(a.w * bc + b.w * ca + c.w * ab) / (abs(det) > 1e-20 ? det : 1.0);
    return abs(det) > 1e-20 ? e : cvLocalEyePos;
}

float3 MWSunDir()
{
    return normalize(lerp(mwSunDirection, cvLocalLightVec.xyz, mwSunSource));
}

// MW daytime lighting (MW world.fx formula + speed.exe 0x6D6CF0 scattering), per vertex.
// wpos/wnrm/eyeW in world space. vcol = Carbon's baked lighting (used as AO).
void MWDaylight(float3 wpos, float3 wnrm, float3 eyeW, float3 vcol,
                out float3 ambE, out float3 sun, out float3 inscat)
{
    float3 L     = MWSunDir();
    float3 toEye = eyeW - wpos;
    float  dist  = length(toEye);
    float3 V     = toEye / max(dist, 1e-3);
    float  cosT  = dot(L, V);

    float  s     = clamp(dist * mwFogDistanceScale, 0.0, 2500.0);
    float3 BrBm  = mwBetaRayleigh + mwBetaMie;
    float3 E     = exp(-s * BrBm);

    float  g      = mwMieG;
    float  phaseR = 1.0 + cosT * cosT;
    float  phaseM = (1.0 - g) * (1.0 - g) * pow(max(1.0 + g * g - 2.0 * g * cosT, 1e-4), -1.5);
    float3 BrT    = mwBetaRayleigh * (3.0 / (16.0 * PI)) * phaseR;
    float3 BmT    = mwBetaMie * (1.0 / (4.0 * PI)) * phaseM;
    inscat = saturate((BrT + BmT) / BrBm * (1.0 - E) * mwInscatterIntensity) * mwInscatterTint;

    float  ao = lerp(1.0, saturate(dot(vcol, LUMINANCE) * mwBakedAOScale), mwBakedAOStrength);
    float3 vc = lerp(ao.xxx, vcol, mwBakedLightMix);
    ambE = mwAmbientColour.rgb * mwAmbientColour.w * vc * min(E, 1.0);
    sun  = saturate(dot(wnrm, L)) * mwDiffuseColour.rgb * lerp(1.0, min(E, 1.0), mwSunExtinction);
}

// Original Carbon fog (z = clip z). Daytime: off unless mwCarbonFogMix.
float CarbonFogDay(float z)
{
    float f   = saturate((cvFogValue.x - z) * cvFogValue.y);
    float fog = 1.0 - pow(1.0 - f, cvFogValue.w) * cvFogValue.z * cfFogEnable;
    return lerp(fog, 1.0, mwDayBlend * (1.0 - mwCarbonFogMix));
}


//-----------------------------------------------------------------------------
// Sky parameters (sky.fx only)
//-----------------------------------------------------------------------------
float4 mwSkyZenithColour   = float4(0.30, 0.48, 0.76, 1.0);
float4 mwSkyHorizonColour  = float4(0.82, 0.80, 0.72, 1.0);   // yellowish haze typical of MW
float  mwSkyGradientPower  = 0.45;
float  mwSkyScatterMix     = 0.35;   // 0 = gradient only, 1 = MW scattering only
float  mwSkyDistZenith     = 8000.0; // atmosphere distance (units) for sky scattering
float  mwSkyDistHorizon    = 40000.0;
float  mwSkyBrightness     = 1.0;
float4 mwSunGlowColour     = float4(1.00, 0.86, 0.62, 1.0);
float  mwSunGlowPower      = 12.0;
float  mwSunGlowIntensity  = 0.35;
float4 mwSunDiskColour     = float4(1.00, 0.96, 0.85, 1.0);
float  mwSunDiskSize       = 0.9994; // cosine of the disk angle
float  mwSunDiskIntensity  = 3.0;
float  mwCloudOpacity      = 1.0;
float  mwCloudBrightness   = 1.15;
float  mwCloudHorizonFade  = 0.12;

struct VS_IN_SKY
{
    float4 pos : POSITION;
    float4 uv  : TEXCOORD0;
};

struct VS_OUT_SKY
{
    float4 pos  : POSITION;
    float4 uv   : TEXCOORD0;   // xyz = original uv, w = mip bias
    float4 opos : TEXCOORD1;   // dome position (object space)
    float  fog  : FOG;
};

struct PS_IN_SKY
{
    float4 uv   : TEXCOORD0;
    float4 opos : TEXCOORD1;
    float  fog  : FOG;
};

VS_OUT_SKY VS_Sky(VS_IN_SKY i)
{
    VS_OUT_SKY o;
    o.pos  = mul(i.pos, WorldViewProj);
    o.fog  = saturate((i.pos.z - cfSkyFogFalloff.y) * cfSkyFogFalloff.x);   // original
    o.uv   = float4(i.uv.xyz, cfMipMapBias);
    o.opos = i.pos;
    return o;
}

// Carbon's original night sky: exact HLSL port of the vanilla ps_3_0 (moon from MISCMAP1, lit cloud
// edges and cloud tint from the DIFFUSEMAP alpha/red channels, Carbon fog colour, brightness).
float3 CarbonNightSky(float2 uv, float3 P, float fog)
{
    const float3 M  = float3(-50000.0, 60000.0, 30000.0);          // moon position
    const float4 c6 = float4(0.0995037, 0.995037, 0.0, 0.00015625);
    float3 r0   = M - P;
    float3 D    = normalize(r0);
    float  dist = dot(r0, D);
    float3 ax   = D.yzx * c6.yzx - D.zxy * c6.xyz;
    float3 V    = normalize(P - cvLocalEyePos.xyz);
    float3 U    = normalize(ax);
    float  t    = dist - dot(V, D);
    float3 W    = normalize(D.yzx * U.zxy - D.zxy * U.yzx);
    float3 q    = t * V + P - M;
    float2 muv  = (float2(dot(U, q), dot(W, q)) * float2(1.21, 1.0) + 3200.0) * c6.w;
    float4 moon = tex2D(MISCMAP1_SAMPLER, muv);
    float  f    = min(1.0 / pow(sqrt(dot(q, q)) * 0.000477, 0.57), 0.915);
    float3 col  = (1.0 - P.z * 0.000142857) * float3(0.02, 0.04, 0.07)
                + moon.y * pow(f, 1.7) * float3(0.99, 1.0, 0.92);
    float  y    = saturate(f * 0.357143);
    float  d    = saturate(length(float3(0.0, 0.0, 7000.0) - P) * 6.80272e-05);
    d = d * d;
    float4 c    = tex2D(DIFFUSEMAP_SAMPLER, uv * 2.77 + cfTimeTicker * float2(-0.14, -0.28));
    float  fade = 1.0 - d * d;
    float  cov  = fade * c.w;
    float  clr  = 1.0 - c.w * fade;
    float  edge = pow(cov * clr, 3.07) * 200.0 * (y * y * (3.0 - 2.0 * y));
    float  m    = 1.0 - f; m = m * m; m = m * m;
    float3 o    = col * clr + edge + cov * c.x * c.x * 0.34 * m;
    o = lerp(cvFogColour.rgb, o, fog);
    return o * (cvVertexPowerBrightness.y * 0.5);
}

float4 PS_Sky(PS_IN_SKY i) : COLOR0
{
    float3 V   = normalize(i.opos.xyz - cvLocalEyePos.xyz);   // view direction to the dome
    float  h01 = saturate(V.z);
    float3 L   = MWSunDir();

    // gradient midday
    float3 grad = lerp(mwSkyHorizonColour.rgb, mwSkyZenithColour.rgb, pow(h01, mwSkyGradientPower));

    // MW scattering along the view ray (V to the eye = -V, same convention as world)
    float  cosT   = dot(L, -V);
    float  s      = lerp(mwSkyDistHorizon, mwSkyDistZenith, h01);
    float3 BrBm   = mwBetaRayleigh + mwBetaMie;
    float3 E      = exp(-s * BrBm);
    float  g      = mwMieG;
    float  phaseR = 1.0 + cosT * cosT;
    float  phaseM = (1.0 - g) * (1.0 - g) * pow(max(1.0 + g * g - 2.0 * g * cosT, 1e-4), -1.5);
    float3 BrT    = mwBetaRayleigh * (3.0 / (16.0 * PI)) * phaseR;
    float3 BmT    = mwBetaMie * (1.0 / (4.0 * PI)) * phaseM;
    float3 inscat = saturate((BrT + BmT) / BrBm * (1.0 - E) * mwInscatterIntensity) * mwInscatterTint;

    float3 sky = lerp(grad, inscat, mwSkyScatterMix);

    // sun
    float cosSun = saturate(dot(V, L));
    sky += mwSunGlowColour.rgb * pow(cosSun, mwSunGlowPower) * mwSunGlowIntensity;
    sky += mwSunDiskColour.rgb * smoothstep(mwSunDiskSize, 1.0, cosSun) * mwSunDiskIntensity;

    // clouds: mask from Carbon's cloud texture, uv & scroll same as the original PS
    float2 cuv  = i.uv.xy * 2.76999998 + cfTimeTicker * float2(-0.140000001, -0.280000001);
    float4 ctex = tex2Dbias(DIFFUSEMAP_SAMPLER, float4(cuv, 0.0, i.uv.w));
    float  cover = saturate(ctex.a * mwCloudOpacity) * smoothstep(0.0, mwCloudHorizonFade, V.z);
    float3 cloud = (mwAmbientColour.rgb * mwAmbientColour.w * 1.6
                  + mwDiffuseColour.rgb * (0.6 + 0.4 * cosSun)) * mwCloudBrightness;
    sky = lerp(sky, cloud, cover);

    // Carbon's original night sky (for mwDayBlend < 1)
    float3 night = CarbonNightSky(i.uv.xy, i.opos.xyz, i.fog);

    return float4(lerp(night, sky * mwSkyBrightness, mwDayBlend), 1.0);
}

//-----------------------------------------------------------------------------
// Techniques: same order & annotations as the original
//-----------------------------------------------------------------------------
technique sky < int shader = 3; >
{
    pass p0
    {
        ZWriteEnable = false;   // original
        CullMode = CW;   // original
        AlphaBlendEnable = true;   // original
        SrcBlend = SRCALPHA;   // original
        DestBlend = INVSRCALPHA;   // original
        VertexShader = compile vs_3_0 VS_Sky();
        PixelShader  = compile ps_3_0 PS_Sky();
    }
}

technique sky_sm1 < int shader = 1; >
{
    pass p0
    {
        ZWriteEnable = false;   // original
        CullMode = CW;   // original
        AlphaBlendEnable = true;   // original
        SrcBlend = SRCALPHA;   // original
        DestBlend = INVSRCALPHA;   // original
        VertexShader = compile vs_3_0 VS_Sky();
        PixelShader  = compile ps_3_0 PS_Sky();
    }
}
