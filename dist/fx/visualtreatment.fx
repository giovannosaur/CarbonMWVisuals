technique visualtreatment_sm1 < int shader = 1; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_1_1
            dcl_position v0
            dcl_texcoord v1
            mov oPos, v0
            mov oT0, v1
        };
        PixelShader = asm
        {
            ps_2_0
            dcl_pp t0.xy
            dcl_2d s0
            dcl_2d s1
            dcl_2d s2
            dcl_volume s3
            texld_pp r1, t0, s2
            texld_pp r0, t0, s0
            mad_pp r0.xyz, c1.x, r1, r0
            texld_pp r1, r0, s3
            dp3_pp r3.w, r0, c12                // MW grade: luminance
            mul_pp r3.xyz, r0, c9.x
            mad_pp r3.xyz, r3.w, c9.y, r3        // desaturation
            add_pp r3.xyz, r3, -c9.w
            mad_sat_pp r3.xyz, r3, c9.z, c9.w    // contrast around the pivot
            mul_pp r4.xyz, r3, r3
            mad_pp r5.xyz, r3, c10.x, c10.y
            mul_pp r4.xyz, r4, r5                // smoothstep
            lrp_pp r5.xyz, c10.z, r4, r3         // S-curve mix
            mul_pp r5.xyz, r5, c11               // tint * brightness
            lrp_pp r4.xyz, c11.w, r5, r1         // Carbon LUT -> MW grade (mwDayBlend)
            mov_pp r1.xyz, r4
            texld_pp r2, t0, s1
            mul_pp r0.xyz, r1, r2.z
            mul_pp r0.xyz, r0, c0.x
            mov_pp oC0, r0
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <MISCMAP2_SAMPLER>;
        Sampler[2] = <MISCMAP3_SAMPLER>;
        Sampler[3] = <VOLUMEMAP_SAMPLER>;
        PixelShaderConstantF[1] = float4(cfBloomScale * lerp(1.0, mwVTBloomScale, mwDayBlend), 0, 0, 0);
        PixelShaderConstantF[0] = (cvVisualTreatmentParams);
        PixelShaderConstantF[9]  = float4(mwVTDesatColour, mwVTDesatLuma, mwVTContrast, mwVTPivot);
        PixelShaderConstantF[10] = float4(-2.0, 3.0, mwVTCurve, 0);
        PixelShaderConstantF[11] = float4(mwVTTint * mwVTBrightness, mwDayBlend);
        PixelShaderConstantF[12] = float4(0.2125, 0.7154, 0.0721, 0);
    }
}
