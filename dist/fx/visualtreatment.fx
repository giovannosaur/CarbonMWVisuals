//=============================================================================
//  visualtreatment.fx  --  NFS Carbon VisualTreatment + MW style colour grading
//  GENERATED by make_visualtreatment.py from the original IDI_VISUALTREATMENT_FX.
//
//  Every technique = original Carbon code (asm). In visualtreatment & _enchanced, the result of
//  Carbon's 3D LUT (night grading) is blended (mwDayBlend) into an MW style grade:
//    desaturation -> contrast around the pivot -> S-curve -> warm tint * brightness.
//  Carbon's per-zone desaturation is disabled & bloom reduced in daytime.
//  The original MW curve = SPLINE texture + MW VLT values; this is a parametric approximation.
//  Loader: CarbonMWVisuals.asi. Annotation <int shader> = original value (REQUIRED).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
shared float4    cvDownSampleOffset0 : REG_cvDownSampleOffset0;
shared float4    cvDownSampleOffset1 : REG_cvDownSampleOffset1;
shared float4    cvVisualEffectFadeColour : REG_cvVisualEffectFadeColour;
shared float     cfVisualEffectFilterBlend : REG_cfVisualEffectFilterBlend;
shared float4    cvVisualTreatmentParams : REG_cvVisualTreatmentParams;
shared float     cfBloomScale : REG_cfBloomScale;
shared float4    cvDepthOfFieldParams : REG_cvDepthOfFieldParams;
shared bool      cbHDREnabled;
shared bool      cbDepthOfFieldEnabled;
shared bool      cbDrawDepthOfField;
shared float4    cvBlurParams : REG_cvBlurParams;
float4    cvTextureOffset : REG_cvTextureOffset;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   MOTIONBLUR_TEXTURE;
sampler MOTIONBLUR_SAMPLER = sampler_state
{
    Texture = <MOTIONBLUR_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   MISCMAP2_TEXTURE;
sampler MISCMAP2_SAMPLER = sampler_state
{
    Texture = <MISCMAP2_TEXTURE>;
    AddressU = CLAMP;
    AddressV = WRAP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   MISCMAP3_TEXTURE;
sampler MISCMAP3_SAMPLER = sampler_state
{
    Texture = <MISCMAP3_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
sampler MISCMAP4_SAMPLER = sampler_state
{
};
texture   MISCMAP5_TEXTURE;
sampler MISCMAP5_SAMPLER = sampler_state
{
    Texture = <MISCMAP5_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   MISCMAP6_TEXTURE;
sampler MISCMAP6_SAMPLER = sampler_state
{
    Texture = <MISCMAP6_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   DEPTHBUFFER_TEXTURE;
sampler DEPTHBUFFER_SAMPLER = sampler_state
{
    Texture = <DEPTHBUFFER_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   VOLUMEMAP_TEXTURE;
sampler3D VOLUMEMAP_SAMPLER = sampler_state
{
    Texture = <VOLUMEMAP_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    AddressW = CLAMP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   BLENDVOLUMEMAP_TEXTURE;
sampler3D BLENDVOLUMEMAP_SAMPLER = sampler_state
{
    Texture = <BLENDVOLUMEMAP_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    AddressW = CLAMP;
    MipFilter = LINEAR;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
float     kWeights[8] = { 6, 5, 4, 3, 2, 1, 1, 1 };

//-----------------------------------------------------------------------------
// MW grading parameters (daytime). Edit, then restart the game.
//-----------------------------------------------------------------------------
float  mwDayBlend          = 1.0;
float  mwVTDesatColour     = 0.85;  // original colour share } desaturation: c*Colour + luma*Luma
float  mwVTDesatLuma       = 0.15;  // luminance share     } (sum of 1 = same brightness)
float  mwVTContrast        = 1.12;  // linear contrast around the pivot
float  mwVTPivot           = 0.45;
float  mwVTCurve           = 0.35;  // 0 = linear, 1 = full S-curve (smoothstep)
float3 mwVTTint            = float3(1.06, 1.03, 0.86);   // warm yellow-green tint typical of MW
float  mwVTBrightness      = 1.17;
float  mwVTBloomScale      = 2.4;   // Carbon bloom multiplier in daytime
float  mwVTKillCarbonDesat = 1.0;   // 1 = disable Carbon's per-zone desaturation in daytime

//-----------------------------------------------------------------------------
// Techniques: same order & annotations as the original
//-----------------------------------------------------------------------------
technique visualtreatment < int shader = 2; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_1_1
            dcl_position v0
            dcl_texcoord v1
            mov oPos, v0
            mov oT0, v1
        };
        PixelShader = asm
        {
            ps_2_0
            dcl_pp t0.xy
            dcl_2d s0
            dcl_2d s1
            dcl_2d s2
            dcl_volume s3
            texld_pp r1, t0, s2
            texld_pp r0, t0, s0
            mad_pp r0.xyz, c1.x, r1, r0
            texld_pp r1, r0, s3
            dp3_pp r3.w, r0, c12                // MW grade: luminance
            mul_pp r3.xyz, r0, c9.x
            mad_pp r3.xyz, r3.w, c9.y, r3        // desaturation
            add_pp r3.xyz, r3, -c9.w
            mad_sat_pp r3.xyz, r3, c9.z, c9.w    // contrast around the pivot
            mul_pp r4.xyz, r3, r3
            mad_pp r5.xyz, r3, c10.x, c10.y
            mul_pp r4.xyz, r4, r5                // smoothstep
            lrp_pp r5.xyz, c10.z, r4, r3         // S-curve mix
            mul_pp r5.xyz, r5, c11               // tint * brightness
            lrp_pp r4.xyz, c11.w, r5, r1         // Carbon LUT -> MW grade (mwDayBlend)
            mov_pp r1.xyz, r4
            texld_pp r2, t0, s1
            mul_pp r0.xyz, r1, r2.z
            mul_pp r0.xyz, r0, c0.x
            mov_pp oC0, r0
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <MISCMAP2_SAMPLER>;
        Sampler[2] = <MISCMAP3_SAMPLER>;
        Sampler[3] = <VOLUMEMAP_SAMPLER>;
        PixelShaderConstantF[1] = float4(cfBloomScale * lerp(1.0, mwVTBloomScale, mwDayBlend), 0, 0, 0);
        PixelShaderConstantF[0] = (cvVisualTreatmentParams);
        PixelShaderConstantF[9]  = float4(mwVTDesatColour, mwVTDesatLuma, mwVTContrast, mwVTPivot);
        PixelShaderConstantF[10] = float4(-2.0, 3.0, mwVTCurve, 0);
        PixelShaderConstantF[11] = float4(mwVTTint * mwVTBrightness, mwDayBlend);
        PixelShaderConstantF[12] = float4(0.2125, 0.7154, 0.0721, 0);
    }
}

technique visualtreatment_enchanced < int shader = 2; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_2_0
            dcl_position v0
            dcl_texcoord v1
            mov oPos, v0
            mov oT0, v1
        };
        PixelShader = asm
        {
            ps_2_0
            def c6, -1, 0.999999881, 1, 0
            def c7, 0.300000012, 0.5, 0, 0
            def c8, 0.212500006, 0.715399981, 0.0720999986, 0
            dcl_pp t0.xy
            dcl_2d s0
            dcl_2d s1
            dcl_2d s2
            dcl_2d s3
            dcl_2d s4
            dcl_volume s5
            dcl_volume s6
            texld_pp r0, t0, s4
            add_pp r0.w, r0.x, c6.x
            mul r0.w, r0.w, r0.w
            cmp_pp r0.w, -r0.w, c6.y, r0.x
            add_pp r1.w, -r0.w, c6.z
            rcp_pp r0.w, r1.w
            add_pp r0.w, r0.w, -c3.x
            abs_pp r0.w, r0.w
            add_pp r0.w, r0.w, -c3.y
            mul_pp r0.w, r0.w, c3.z
            mul_sat_pp r0.w, r1.w, r0.w
            cmp r3.w, -r0.w, c7.y, c7.z
            add_pp r4.w, -r0.w, c6.z
            mul_pp r1.w, r0.w, c3.w
            mov_pp r0.w, r1.w
            mov_pp r0.xy, t0
            mov_sat_pp r5.w, r1.w
            mov r0.z, c6.w
            texldb_pp r2, r0, s3
            texld_pp r0, t0, s0
            lrp_pp r1.xyz, r5.w, r2, r0
            mad_pp r1.w, r4.w, c7.x, r1.x
            add_pp r2.yz, r3.w, r1
            add_pp r2.x, r3.w, r1.w
            cmp_pp r1.xyz, -c5.x, r1, r2
            mov_pp r1.w, r0.w
            cmp_pp r0, -c4.x, r0, r1
            texld_pp r4, r0, s5
            texld_pp r3, r0, s6
            texld_pp r1, t0, s1
            texld_pp r2, t0, s2
            lrp_pp r5.xyz, c1.z, r3, r4
            dp3_pp r6.w, r0, c12                // MW grade: luminance
            mul_pp r6.xyz, r0, c9.x
            mad_pp r6.xyz, r6.w, c9.y, r6        // desaturation
            add_pp r6.xyz, r6, -c9.w
            mad_sat_pp r6.xyz, r6, c9.z, c9.w    // contrast around the pivot
            mul_pp r7.xyz, r6, r6
            mad_pp r8.xyz, r6, c10.x, c10.y
            mul_pp r7.xyz, r7, r8                // smoothstep
            lrp_pp r8.xyz, c10.z, r7, r6         // S-curve mix
            mul_pp r8.xyz, r8, c11               // tint * brightness
            lrp_pp r7.xyz, c11.w, r8, r5         // Carbon LUT -> MW grade (mwDayBlend)
            mov_pp r5.xyz, r7
            mov_sat_pp r1.w, r1.y
            dp3_pp r1.x, c8, r5
            mul_pp r1.w, r1.w, c1.y
            lrp_pp r0.xyz, r1.w, r1.x, r5
            mul_pp r2.xyz, r2, c2.x
            mad_pp r1.xyz, r0, r1.z, r2
            lrp_pp r0.xyz, c0.w, c0, r1
            mul_pp r0.xyz, r0, c1.x
            mov_pp oC0, r0
        };
        Sampler[6] = <BLENDVOLUMEMAP_SAMPLER>;
        Sampler[4] = <DEPTHBUFFER_SAMPLER>;
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <MISCMAP2_SAMPLER>;
        Sampler[2] = <MISCMAP3_SAMPLER>;
        Sampler[3] = <MISCMAP6_SAMPLER>;
        Sampler[5] = <VOLUMEMAP_SAMPLER>;
        PixelShaderConstantF[4] = float4(cbDepthOfFieldEnabled, 0, 0, 0);
        PixelShaderConstantF[5] = float4(cbDrawDepthOfField, 0, 0, 0);
        PixelShaderConstantF[2] = float4(cfBloomScale * lerp(1.0, mwVTBloomScale, mwDayBlend), 0, 0, 0);
        PixelShaderConstantF[3] = (cvDepthOfFieldParams);
        PixelShaderConstantF[0] = (cvVisualEffectFadeColour);
        PixelShaderConstantF[1] = float4(cvVisualTreatmentParams.x, cvVisualTreatmentParams.y * (1.0 - mwDayBlend * mwVTKillCarbonDesat), cvVisualTreatmentParams.z, cvVisualTreatmentParams.w);
        PixelShaderConstantF[9]  = float4(mwVTDesatColour, mwVTDesatLuma, mwVTContrast, mwVTPivot);
        PixelShaderConstantF[10] = float4(-2.0, 3.0, mwVTCurve, 0);
        PixelShaderConstantF[11] = float4(mwVTTint * mwVTBrightness, mwDayBlend);
        PixelShaderConstantF[12] = float4(0.2125, 0.7154, 0.0721, 0);
    }
}

technique motionblur < int shader = 3; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_3_0
            dcl_position v0
            dcl_texcoord v1
            dcl_texcoord1 v2
            dcl_texcoord2 v3
            dcl_texcoord3 v4
            dcl_texcoord4 v5
            dcl_texcoord5 v6
            dcl_texcoord6 v7
            dcl_texcoord7 v8
            dcl_position o0
            dcl_texcoord o1.xy
            dcl_texcoord1 o2.xy
            dcl_texcoord2 o3.xy
            dcl_texcoord3 o4.xy
            dcl_texcoord4 o5.xy
            dcl_texcoord5 o6.xy
            dcl_texcoord6 o7.xy
            dcl_texcoord7 o8.xy
            mov o0, v0
            mov o1.xy, v1
            mov o2.xy, v2
            mov o3.xy, v3
            mov o4.xy, v4
            mov o5.xy, v5
            mov o6.xy, v6
            mov o7.xy, v7
            mov o8.xy, v8
        };
        PixelShader = asm
        {
            ps_3_0
            def c9, 0.0434782617, 0, 0, 0
            dcl_texcoord v1.xy
            dcl_texcoord1 v2.xy
            dcl_texcoord2 v3.xy
            dcl_texcoord3 v4.xy
            dcl_texcoord4 v5.xy
            dcl_texcoord5 v6.xy
            dcl_texcoord6 v7.xy
            dcl_texcoord7 v8.xy
            dcl_2d s0
            texld_pp r1, v2, s0
            add_pp r0.xyz, -r1, c8.x
            rcp_pp r0.x, r0.x
            rcp_pp r0.y, r0.y
            rcp_pp r0.z, r0.z
            mul_pp r2.xyz, r1, r0
            max_pp r0.xyz, r1, r2
            texld_pp r2, v1, s0
            add_pp r1.xyz, -r2, c8.x
            mov_pp r0.w, r1.w
            rcp_pp r1.x, r1.x
            rcp_pp r1.y, r1.y
            rcp_pp r1.z, r1.z
            mov r4.w, c9.x
            mul r1.w, r4.w, c1.x
            mul_pp r3.xyz, r2, r1
            mul r1, r0, r1.w
            max_pp r0.xyz, r2, r3
            texld_pp r3, v3, s0
            add_pp r2.xyz, -r3, c8.x
            mov_pp r0.w, r2.w
            rcp_pp r2.x, r2.x
            rcp_pp r2.y, r2.y
            rcp_pp r2.z, r2.z
            mul r2.w, r4.w, c0.x
            mul_pp r2.xyz, r3, r2
            mad_pp r1, r0, r2.w, r1
            max_pp r0.xyz, r3, r2
            texld_pp r2, v4, s0
            add_pp r3.xyz, -r2, c8.x
            mov_pp r0.w, r3.w
            rcp_pp r3.x, r3.x
            rcp_pp r3.y, r3.y
            rcp_pp r3.z, r3.z
            mul r3.w, r4.w, c2.x
            mul_pp r3.xyz, r2, r3
            mad_pp r1, r0, r3.w, r1
            max_pp r0.xyz, r2, r3
            texld_pp r3, v5, s0
            add_pp r2.xyz, -r3, c8.x
            mov_pp r0.w, r2.w
            rcp_pp r2.x, r2.x
            rcp_pp r2.y, r2.y
            rcp_pp r2.z, r2.z
            mul r2.w, r4.w, c3.x
            mul_pp r2.xyz, r3, r2
            mad_pp r1, r0, r2.w, r1
            max_pp r0.xyz, r3, r2
            texld_pp r2, v6, s0
            add_pp r3.xyz, -r2, c8.x
            mov_pp r0.w, r3.w
            rcp_pp r3.x, r3.x
            rcp_pp r3.y, r3.y
            rcp_pp r3.z, r3.z
            mul r3.w, r4.w, c4.x
            mul_pp r3.xyz, r2, r3
            mad_pp r1, r0, r3.w, r1
            max_pp r0.xyz, r2, r3
            texld_pp r3, v7, s0
            add_pp r2.xyz, -r3, c8.x
            mov_pp r0.w, r2.w
            rcp_pp r2.x, r2.x
            rcp_pp r2.y, r2.y
            rcp_pp r2.z, r2.z
            mul r2.w, r4.w, c5.x
            mul_pp r2.xyz, r3, r2
            mad_pp r1, r0, r2.w, r1
            max_pp r0.xyz, r3, r2
            texld_pp r2, v8, s0
            add_pp r3.xyz, -r2, c8.x
            mov_pp r0.w, r3.w
            rcp_pp r3.x, r3.x
            rcp_pp r3.y, r3.y
            rcp_pp r3.z, r3.z
            mul r3.w, r4.w, c6.x
            mul_pp r3.xyz, r2, r3
            mad_pp r1, r0, r3.w, r1
            max_pp r0.xyz, r2, r3
            mov_pp r0.w, r2.w
            mul r2.w, r4.w, c7.x
            mad_pp oC0, r0, r2.w, r1
        };
        Sampler[0] = <MOTIONBLUR_SAMPLER>;
        PixelShaderConstantF[8] = (cvBlurParams);
        PixelShaderConstantF[0] = float4(kWeights[0], 0, 0, 0);
        PixelShaderConstantF[1] = float4(kWeights[1], 0, 0, 0);
        PixelShaderConstantF[2] = float4(kWeights[2], 0, 0, 0);
        PixelShaderConstantF[3] = float4(kWeights[3], 0, 0, 0);
        PixelShaderConstantF[4] = float4(kWeights[4], 0, 0, 0);
        PixelShaderConstantF[5] = float4(kWeights[5], 0, 0, 0);
        PixelShaderConstantF[6] = float4(kWeights[6], 0, 0, 0);
        PixelShaderConstantF[7] = float4(kWeights[7], 0, 0, 0);
    }
}

technique composite_blur < int shader = 3; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_3_0
            dcl_position v0
            dcl_texcoord v1
            dcl_position o0
            dcl_texcoord o1
            mov o0, v0
            mov o1, v1
        };
        PixelShader = asm
        {
            ps_3_0
            dcl_texcoord_pp v1.xy
            dcl_2d s0
            dcl_2d s1
            texld_pp r1, v1, s1
            mul_pp r1.w, r1.w, c0.x
            texld_pp r0, v1, s0
            add_pp r1.xyz, r1, -r0
            mad_pp oC0.xyz, r1.w, r1, r0
            mov_pp oC0.w, r0.w
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <MOTIONBLUR_SAMPLER>;
        PixelShaderConstantF[0] = (cvBlurParams);
    }
}

technique uvesovercliff < int shader = 2; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_2_0
            dcl_position v0
            dcl_texcoord v1
            mov oPos, v0
            mov oT0, v1
        };
        PixelShader = asm
        {
            ps_2_0
            def c1, 0.212500006, 0.715399981, 0.0720999986, 1.60000002
            def c2, 1.12, 0.25, -0.25, 3
            def c3, 3.20367098, 2.83257604, -0.5, 0.300000012
            dcl_pp t0.xy
            dcl_2d s0
            texld_pp r0, t0, s0
            add_pp r1.xy, t0, c0
            cmp r0.w, r1.x, c2.y, c2.z
            rcp r1.w, r0.w
            mul r1.w, r1.x, r1.w
            frc r1.w, r1.w
            mad r0.w, r0.w, r1.w, c2.w
            mul r0.w, r0.w, c3.x
            exp r0.w, r0.w
            cmp r1.w, r1.y, c2.y, c2.z
            rcp r2.w, r1.w
            mul r2.w, r1.y, r2.w
            frc r2.w, r2.w
            mad r1.w, r1.w, r2.w, c2.w
            mul r1.w, r1.w, c3.y
            exp r1.w, r1.w
            mul r0.w, r0.w, r1.w
            frc_pp r0.w, r0.w
            add_sat_pp r1.w, r0.w, c3.z
            dp3_pp r0.x, c1, r0
            mul_pp r2.w, r0.x, c1.w
            pow_pp r0.w, r2.w, c2.x
            mul_pp r0.w, r0.w, c1.w
            mad_pp r1.w, r0.w, r1.w, -r0.w
            mad_pp r0.xyz, c3.w, r1.w, r0.w
            mov_pp oC0, r0
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        PixelShaderConstantF[0] = (cvTextureOffset);
    }
}

technique uvesovercliffdarken < int shader = 2; >
