            lrp_pp r0.xyz, c0.w, c0, r1
            mov_pp r0.w, r1.w
            mov_pp oC0, r0
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        PixelShaderConstantF[0] = (cvVisualEffectFadeColour);
    }
}

