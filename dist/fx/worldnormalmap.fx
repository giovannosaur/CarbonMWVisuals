//=============================================================================
//  worldnormalmap.fx  --  NFS Carbon WorldNormalMap (buildings) + MW daytime lighting
//  GENERATED by make_worldnormalmap.py from the original IDI_WORLDNORMALMAP_FX.
//
//  [0] worldnormalmap (SM3): PS = original Carbon code (normal map + 2 headlights) with
//      added: PER-PIXEL sun N.L using the world-space normal map, the blue light
//      "from above" (moon) switched off in daytime, MW inscatter before fog.
//      VS = replica of the original; COLOR.rgb (baked night lights) -> 2*MW ambient.
//  [1] lowlod (distant buildings): full HLSL, MW per-vertex lighting.
//  [2],[3] SM2/SM1 fallbacks use the SM3 shaders (renamed, d3dx9_43 rejects duplicates).
//  Loader: CarbonMWVisuals.asi. Annotation <int shader> = original value (REQUIRED).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect: names, types, shared, semantics, order)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
shared float4x4  cmWorldView : REG_cmWorldView;
shared float4    cvLocalLightVec : REG_cvLocalLightVec;
shared float4x4  cmWorldMat : REG_cmWorldMat;
shared float4x4  cmWorldMatTranspose : REG_cmWorldMatTranspose;
float4    cvDiffuseColour : REG_cvDiffuseColour;
float4    cvSpecularColour : REG_cvSpecularColour;
float     cfSpecularPower : REG_cfSpecularPower;
shared float3    cvLocalEyePos : REG_cvLocalEyePos;
shared float     cfMipMapBias : REG_cfMipMapBias;
shared int       cbIsParallexMapped;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
texture   NORMALMAP_TEXTURE;
sampler NORMALMAP_SAMPLER = sampler_state
{
    Texture = <NORMALMAP_TEXTURE>;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
    AddressU = WRAP;
    AddressV = WRAP;
};
texture   MISCMAP1_TEXTURE;
sampler MISCMAP1_SAMPLER = sampler_state
{
    Texture = <MISCMAP1_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
shared float4    cvHeadlight1Colour;
shared float4    cvHeadlight2Colour;
shared float4    cavWorldHeadlightDirection[2] : REG_cavWorldHeadlightDirection;
shared float4    cavWorldHeadlightUpDirection[2] : REG_cavWorldHeadlightUpDirection;
shared float4    cavWorldHeadlightPosition[2] : REG_cavWorldHeadlightPosition;
shared texture   HEADLIGHT_TEXTURE;
shared texture   HEADLIGHT_CLIP_TEXTURE;
float4x4  cmHeadlight1WVP : REG_cmHeadlight1WVP;
sampler HEADLIGHT_SAMPLER = sampler_state
{
    Texture = <HEADLIGHT_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   HEADLIGHT_TEXTURE_OLD;
sampler HEADLIGHT_SAMPLER_OLD = sampler_state
{
    Texture = <HEADLIGHT_TEXTURE_OLD>;
    MagFilter = LINEAR;
    MipFilter = NONE;
    MinFilter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};
sampler HEADLIGHT_CLIP_SAMPLER = sampler_state
{
    Texture = <HEADLIGHT_CLIP_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
float     headlight_colour_scale = 0.400000006;

//-----------------------------------------------------------------------------
// SUN SHADOWS (set by CarbonMWVisuals.asi every frame; shared through the effect pool)
//   mwShadowParams: x = strength (0 = off), y = mode (1 = hw depth compare D24S8,
//                   2 = manual DF16 compare), z = 1/map size
//-----------------------------------------------------------------------------
shared texture  mwShadowMap;
shared float4x4 mwShadowTransform;
shared float4   mwShadowParams = float4(0.0, 1.0, 0.0009765625, 0.0);
shared int      mwShadowFilter = 2;   // 2 = LINEAR (hw 2x2 PCF), 1 = POINT (DF16)
shared float4   mwShadowParams2 = float4(0.0, 1.0, 0.0, 0.0);   // x = darken ambient in shadow, y = PCF radius (texels)

float  mwShadowStrength   = 1.0;      // strength multiplier for this shader (main strength: Strength in CarbonMWVisuals.ini)
float  mwShadowBias       = 0.0004;   // ~0.25 m. Raise it if you see shadow acne, lower it if shadows detach from the base of objects
float  mwShadowSoftness   = 1.0;      // PCF radius multiplier (main radius: Softness in CarbonMWVisuals.ini)

sampler mwShadowSampler = sampler_state
{
    Texture   = <mwShadowMap>;
    MinFilter = <mwShadowFilter>;
    MagFilter = <mwShadowFilter>;
    MipFilter = NONE;
    AddressU  = BORDER;
    AddressV  = BORDER;
    BorderColor = 0xFFFFFFFF;
};


//-----------------------------------------------------------------------------
// MW DAYTIME PARAMETERS (defaults; the Carbon engine never touches these). Z = up.
// Same values in every port shader (world/worldreflect/worldnormalmap/worldprelit).
//-----------------------------------------------------------------------------
float  mwDayBlend         = 1.0;    // 0 = original Carbon shading (night), 1 = full MW daytime
float  mwSunSource        = 0.0;    // 0 = mwSunDirection, 1 = cvLocalLightVec from the engine
float3 mwSunDirection     = float3(0.35, 0.45, 0.82);   // direction TO the sun (world space)
float4 mwDiffuseColour    = float4(0.62, 0.57, 0.48, 1.0);
float4 mwAmbientColour    = float4(0.36, 0.38, 0.42, 1.0);
float3 mwBetaRayleigh     = float3(0.000107, 0.000179, 0.000373);
float3 mwBetaMie          = float3(0.000040, 0.000052, 0.000079);
float  mwMieG             = -0.50;
float  mwInscatterIntensity = 8.1;
float  mwFogDistanceScale = 1.0;
float3 mwInscatterTint    = float3(1.0, 1.0, 1.0);
float  mwSunExtinction    = 0.0;
float  mwBakedLightMix    = 0.0;    // 0 = drop the baked night lights, 1 = use them as they are
float  mwBakedAOStrength  = 0.5;
float  mwBakedAOScale     = 2.0;
float  mwCarbonFogMix     = 0.0;

static const float3 LUMINANCE = float3(0.2125, 0.7154, 0.0721);
static const float  PI        = 3.14159265;


// Camera position (object space) from WorldViewProj: the point where clip x = y = w = 0.
// (cvLocalEyePos can be stale because the engine does not always set it for this shader.)
float3 EyeObjectSpace()
{
    float4x4 T = transpose(WorldViewProj);
    float4 a = T[0], b = T[1], c = T[3];
    float3 bc = cross(b.xyz, c.xyz);
    float3 ca = cross(c.xyz, a.xyz);
    float3 ab = cross(a.xyz, b.xyz);
    float  det = dot(a.xyz, bc);
    float3 e = -(a.w * bc + b.w * ca + c.w * ab) / (abs(det) > 1e-20 ? det : 1.0);
    return abs(det) > 1e-20 ? e : cvLocalEyePos;
}

float3 MWSunDir()
{
    return normalize(lerp(mwSunDirection, cvLocalLightVec.xyz, mwSunSource));
}

// MW daytime lighting (MW world.fx formula + speed.exe 0x6D6CF0 scattering), per vertex.
// wpos/wnrm/eyeW in world space. vcol = Carbon's baked lighting (used as AO).
void MWDaylight(float3 wpos, float3 wnrm, float3 eyeW, float3 vcol,
                out float3 ambE, out float3 sun, out float3 inscat)
{
    float3 L     = MWSunDir();
    float3 toEye = eyeW - wpos;
    float  dist  = length(toEye);
    float3 V     = toEye / max(dist, 1e-3);
    float  cosT  = dot(L, V);

    float  s     = clamp(dist * mwFogDistanceScale, 0.0, 2500.0);
    float3 BrBm  = mwBetaRayleigh + mwBetaMie;
    float3 E     = exp(-s * BrBm);

    float  g      = mwMieG;
    float  phaseR = 1.0 + cosT * cosT;
    float  phaseM = (1.0 - g) * (1.0 - g) * pow(max(1.0 + g * g - 2.0 * g * cosT, 1e-4), -1.5);
    float3 BrT    = mwBetaRayleigh * (3.0 / (16.0 * PI)) * phaseR;
    float3 BmT    = mwBetaMie * (1.0 / (4.0 * PI)) * phaseM;
    inscat = saturate((BrT + BmT) / BrBm * (1.0 - E) * mwInscatterIntensity) * mwInscatterTint;

    float  ao = lerp(1.0, saturate(dot(vcol, LUMINANCE) * mwBakedAOScale), mwBakedAOStrength);
    float3 vc = lerp(ao.xxx, vcol, mwBakedLightMix);
    ambE = mwAmbientColour.rgb * mwAmbientColour.w * vc * min(E, 1.0);
    sun  = saturate(dot(wnrm, L)) * mwDiffuseColour.rgb * lerp(1.0, min(E, 1.0), mwSunExtinction);
}

// Original Carbon fog (z = clip z). Daytime: off unless mwCarbonFogMix.
float CarbonFogDay(float z)
{
    float f   = saturate((cvFogValue.x - z) * cvFogValue.y);
    float fog = 1.0 - pow(1.0 - f, cvFogValue.w) * cvFogValue.z * cfFogEnable;
    return lerp(fog, 1.0, mwDayBlend * (1.0 - mwCarbonFogMix));
}

float  mwHeadlightScale   = 0.0;    // car headlight beams (player + AI) in daytime:
                                    // 0 = off, > 0 = on like Carbon (this asm shader cannot dim it gradually)
float  mwHeadlightOverride = 0.0;  // 1 = mwHeadlightOn decides the beams (time of day clock), 0 = automatic
float  mwHeadlightOn       = 1.0;  // with mwHeadlightOverride = 1: 1 = beams on, 0 = off


//-----------------------------------------------------------------------------
// [0] Vertex shader: replica of the original worldnormalmap vs_3_0
//-----------------------------------------------------------------------------
struct VS_IN_NM
{
    float4 pos : POSITION;
    float3 nrm : NORMAL;
    float4 col : COLOR0;
    float4 uv  : TEXCOORD0;
    float4 tan : TANGENT;
};

struct VS_OUT_NM
{
    float4 pos    : POSITION;
    float4 col    : COLOR0;     // rgb = baked light (night) / 2*MW ambient (day), a = vertex alpha
    float4 uv     : TEXCOORD0;  // (u, v, 1, mip bias)
    float3 nrm    : TEXCOORD1;  // normal object space
    float3 wpos   : TEXCOORD2;  // world position (headlights)
    float4 tan    : TEXCOORD3;
    float  fog    : FOG;
    float3 inscat : TEXCOORD6;  // NEW: MW inscatter (PS: v7)
};

VS_OUT_NM VS_NormalMap(VS_IN_NM i)
{
    VS_OUT_NM o;
    float4 clip = mul(i.pos, WorldViewProj);
    o.pos  = clip;
    float3 wpos = mul(i.pos, cmWorldMat).xyz;
    o.wpos = wpos;

    float3 night = pow(max(i.col.rgb, 1e-6), cvVertexPowerBrightness.x) * cvVertexPowerBrightness.y;
    float3 wnrm  = normalize(mul(i.nrm, (float3x3)cmWorldMat));
    float3 eyeW  = mul(float4(EyeObjectSpace(), 1.0), cmWorldMat).xyz;
    float3 ambE, sun, inscat;
    MWDaylight(wpos, wnrm, eyeW, night, ambE, sun, inscat);
    o.col = float4(lerp(night, 2.0 * ambE, mwDayBlend), i.col.a);   // sun added per pixel in the PS

    o.fog    = CarbonFogDay(clip.z);
    o.uv     = float4(i.uv.xy, 1.0, cfMipMapBias);
    o.nrm    = i.nrm;
    o.tan    = i.tan;
    o.inscat = inscat * mwDayBlend;
    return o;
}

//-----------------------------------------------------------------------------
// [1] lowlod (distant buildings): original = texture * pow(vcol, power.x) * power.y
//-----------------------------------------------------------------------------
struct VS_IN_LOD
{
    float4 pos : POSITION;
    float3 nrm : NORMAL;
    float4 col : COLOR0;
    float4 uv  : TEXCOORD0;
};

struct VS_OUT_LOD
{
    float4 pos    : POSITION;
    float2 uv     : TEXCOORD0;
    float4 light  : TEXCOORD1;  // rgb = texture multiplier (not clamped), a = vertex alpha
    float3 inscat : TEXCOORD2;
};

struct PS_IN_LOD
{
    float2 uv     : TEXCOORD0;
    float4 light  : TEXCOORD1;
    float3 inscat : TEXCOORD2;
};

VS_OUT_LOD VS_LowLod(VS_IN_LOD i)
{
    VS_OUT_LOD o;
    o.pos = mul(i.pos, WorldViewProj);
    o.uv  = i.uv.xy;
    float3 night = pow(max(i.col.rgb, 1e-6), cvVertexPowerBrightness.x) * cvVertexPowerBrightness.y;
    float3 wpos  = mul(i.pos, cmWorldMat).xyz;
    float3 wnrm  = normalize(mul(i.nrm, (float3x3)cmWorldMat));
    float3 eyeW  = mul(float4(EyeObjectSpace(), 1.0), cmWorldMat).xyz;
    float3 ambE, sun, inscat;
    MWDaylight(wpos, wnrm, eyeW, night, ambE, sun, inscat);
    o.light  = float4(lerp(night, 2.0 * (ambE + sun), mwDayBlend), i.col.a);
    o.inscat = inscat * mwDayBlend;
    return o;
}

float4 PS_LowLod(PS_IN_LOD i) : COLOR0
{
    float4 tex = tex2D(DIFFUSEMAP_SAMPLER, i.uv);
    return float4(tex.rgb * i.light.rgb + i.inscat, tex.a * i.light.a);
}

//-----------------------------------------------------------------------------
// Techniques: same order & annotations as the original
//-----------------------------------------------------------------------------
technique worldnormalmap < int shader = 3; >
{
    pass p0
    {
        VertexShader = compile vs_3_0 VS_NormalMap();
        PixelShader = asm
        {
            ps_3_0
            def c207, 1, 0, 0.0625, 0
            def c208, -40, 1, 0, 0.001
            def c11, 1, 0, -0.75, -0.5
            def c12, 0.00425531901, 1, 3.5, 3.70000005
            def c13, 2.70000005, 0.850000024, 0.588235319, -0.400000006
            def c14, 2.47000003, 14, 2, 1
            def c15, 0.5, 1, 0.699999988, -0.100000001
            def c16, 1.39999998, 0, 0, 0
            dcl_color_pp v1
            dcl_texcoord_pp v2
            dcl_texcoord1_pp v3.xyz
            dcl_texcoord2 v4.xyz
            dcl_texcoord3_pp v5
            dcl_fog_pp v6.x
            dcl_2d s0
            dcl_2d s1
            dcl_2d s2
            dcl_texcoord6 v7.xyz
            dcl_2d s8
            mov r24.xyz, v4                  // MW shadow: world position
            mov r24.w, c207.x
            dp4 r25.x, r24, c200
            dp4 r25.y, r24, c201
            dp4 r25.z, r24, c202
            dp4 r25.w, r24, c203
            add r28.y, r25.w, -c208.w              // MW shadow: w <= 0 -> outside the map
            cmp r28.y, r28.y, c207.y, c207.x
            max r25.w, r25.w, c208.w
            rcp r25.w, r25.w
            mul r24.xyz, r25, r25.w              // MW shadow: shadow map coordinates
            add r24.z, r24.z, -c206.x             // MW shadow: - bias
            mov r24.w, c207.x
            mov r25.zw, r24                     // MW shadow: tap group 0
            add r25.xy, r24, c211
            texldp r26, r25, s8
            add r25.xy, r24, c211.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c212
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c212.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r28.w, r25, c207.z
            mov r25.zw, r24                     // MW shadow: tap group 1
            add r25.xy, r24, c213
            texldp r26, r25, s8
            add r25.xy, r24, c213.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c214
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c214.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.zw, r24                     // MW shadow: tap group 2
            add r25.xy, r24, c215
            texldp r26, r25, s8
            add r25.xy, r24, c215.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c216
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c216.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.zw, r24                     // MW shadow: tap group 3
            add r25.xy, r24, c217
            texldp r26, r25, s8
            add r25.xy, r24, c217.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c218
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c218.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.x, r28.w                    // MW shadow: average of 16 taps
            mad r27.xy, r24, -r24, r24
            min r27.x, r27.x, r27.y
            mad_sat r25.y, r27.x, c208.x, c208.y    // MW shadow: fade at the map edge 1 - min*40
            cmp r27.x, r27.x, c207.y, c207.x         // MW shadow: outside the map = lit
            add r27.x, r27.x, r28.y
            add r25.x, r25.x, r25.y
            add_sat r25.x, r25.x, r27.x
            add r25.x, -r25.x, c207.x
            mul r28.x, r25.x, c206.y              // MW shadow: occlusion * strength
            mul r28.z, r25.x, c210.x               // MW shadow: ambient occlusion * Darkness
            add r25.x, -r28.z, c207.x               // MW shadow: ambient x (1 - ambient occlusion)
            mul r29.xyz, v1, r25.x
            mov r29.w, v1.w
            add r0.xyz, -v4, c8
            dp3 r0.w, r0, r0
            rsq r0.w, r0.w
            rcp_pp r1.w, r0.w
            mul r1.xyz, r0, r0.w
            mov_pp r0.xyz, v3
            mul_pp r2.xyz, r0.zxyw, v5.yzxw
            mad_pp r2.xyz, r0.yzxw, v5.zxyw, -r2
            mad r0, v2.xyxx, c11.xxyy, c11.yyyz
            texldb_pp r0, r0, s1
            add_pp r0.xyz, r0, c11.w
            mul_pp r2.xyz, r2, v5.w
            add_pp r0.xyz, r0, r0
            mad_sat_pp r0.w, r1.w, -c12.x, c12.y
            mul r0.w, r0.w, c222.x            // MW: headlight beams (mwHeadlightScale)
            mul_pp r2.xyz, r2, r0.y
            mul_pp r0.w, r0.w, r0.w
            mad_pp r2.xyz, v5, r0.x, r2
            mul_pp r1.w, r0.w, c12.z
            mad_pp r0.xyz, v3, r0.z, r2
            dp3_sat r2.w, r1, -c4
            mul r2.xyz, r0.y, c1
            pow_pp r0.w, r2.w, c12.w
            mad r2.xyz, c0, r0.x, r2
            mul_pp r1.w, r1.w, r0.w
            mad_pp r2.xyz, c2, r0.z, r2
            nrm_pp r6.xyz, r2                 // MW: world-space normal map
            dp3_sat_pp r5.x, r6, c17          // MW: per-pixel sun N.L
            mad r5.x, r5.x, -r28.x, r5.x      // MW shadow: N.L x (1 - occlusion)
            dp3 r0.w, r1, r2
            mov_sat_pp r3.w, v3.z
            max r2.w, r0.w, c11.y
            pow_pp r0.z, r3.w, c14.y
            min r0.w, r2.w, c14.z
            mad_pp r2.w, c14.z, r0.z, c14.w
            min_pp r0.z, r1.w, c13.x
            mul r0.w, r0.w, r2.w
            mul r1.w, r0.z, r0.w
            dp3 r0.w, r1, c6
            add r3.w, -r0_abs.w, c11.x
            add r0.w, r0.w, c13.y
            mul r4.w, r3.w, r3.w
            mov_pp r0.xyz, c4
            mul_pp r3.xyz, r0.zxyw, c6.yzxw
            mad_sat_pp r3.w, r3.w, r4.w, c13.w
            mad_pp r0.xyz, r0.yzxw, c6.zxyw, -r3
            mul_pp r3.w, r3.w, c14.x
            dp3 r0.z, r1, -r0
            mul r1.w, r1.w, r3.w
            add r0.z, r0.z, c11.x
            mad_pp r0.x, r0.z, -c15.x, c15.y
            mul_pp r0.y, r0.w, c13.z
            texld r0, r0, s2
            add r3.xyz, -v4, c7
            dp3 r0.w, r3, r3
            mul_pp r1.xyz, r1.w, r0
            rsq r0.w, r0.w
            mul r0.xyz, r3, r0.w
            rcp_pp r0.w, r0.w
            dp3 r3.w, r0, r2
            mov_sat_pp r1.w, r2.z
            max r2.x, r3.w, c11.y
            mad_sat_pp r0.w, r0.w, -c12.x, c12.y
            mul r0.w, r0.w, c222.x            // MW: headlight beams (mwHeadlightScale)
            mul_pp r2.z, r0.w, r0.w
            dp3_sat r0.w, r0, -c3
            mul_pp r2.y, r2.z, c12.z
            pow_pp r2.z, r0.w, c12.w
            min r0.w, r2.x, c14.z
            mul_pp r3.w, r2.y, r2.z
            mul r0.w, r2.w, r0.w
            min_pp r2.w, r3.w, c13.x
            mul r2.w, r0.w, r2.w
            dp3 r0.w, r0, c5
            add r3.w, -r0_abs.w, c11.x
            add r0.w, r0.w, c13.y
            mul r4.w, r3.w, r3.w
            mov r2.xyz, c3
            mul_pp r3.xyz, r2.zxyw, c5.yzxw
            mad_sat_pp r3.w, r3.w, r4.w, c13.w
            mad_pp r2.xyz, r2.yzxw, c5.zxyw, -r3
            mul_pp r3.w, r3.w, c14.x
            dp3 r0.z, r0, -r2
            mul r2.w, r2.w, r3.w
            add r0.z, r0.z, c11.x
            mad_pp r0.x, r0.z, -c15.x, c15.y
            mul_pp r0.y, r0.w, c13.z
            texld r0, r0, s2
            mad_pp r0.xyz, r2.w, r0, r1
            max_pp r1.xyz, r0, c11.y
            add_pp r0.z, -v3_abs.z, c11.x
            mad_pp r0.w, r1.w, c15.z, c15.w
            mul_pp r1.w, r0.z, r0.z
            min_pp r0.xyz, r1, c16.x
            mul_pp r0.w, r0.w, r1.w
            mul_pp r0.w, r0.w, c19.x          // MW: blue light "from above" x (1 - dayBlend)
            mad_pp r1.xyz, r0.w, c15.zzyw, r29
            mul_pp r0.w, r29.w, c10.x
            mad_pp r1.xyz, r0.w, r0, r1
            mad_pp r1.xyz, r5.x, c18, r1      // MW: + 2 * DiffuseColour * N.L * dayBlend
            mov r25.w, r26.x                    // MW shadow debug: raw sample of tap 0
            mov_sat r26.xy, r24                 // debug 1: R = x, G = y, B = occlusion
            mov_sat r26.z, r28.x
            lrp r27.xyz, c209.y, r25.w, r26         // debug 2: raw value (grey)
            mul r26.xyz, v4, c209.w               // debug 3: 4 m checkerboard from the world position
            frc r26.xyz, r26
            lrp r25.xyz, c209.z, r26, r27
            lrp r26.xyz, c209.x, r25, r1
            mov r1.xyz, r26
            texldb_pp r0, v2, s0
            mad_pp r0.xyz, r1, r0, -c9
            mov_pp oC0.w, r0.w
            add_pp r0.xyz, r0, v7             // MW: inscatter
            mad_pp oC0.xyz, v6.x, r0, c9
        };
        PixelShaderConstantF[222] = float4(1.0 - lerp(mwDayBlend * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), 0, 0, 0);   // MW: headlight beams
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[2] = <HEADLIGHT_SAMPLER>;
        Sampler[1] = <NORMALMAP_SAMPLER>;
        PixelShaderConstantF[3] = (cavWorldHeadlightDirection[0]);
        PixelShaderConstantF[4] = (cavWorldHeadlightDirection[1]);
        PixelShaderConstantF[7] = float4(cavWorldHeadlightPosition[0].x, cavWorldHeadlightPosition[0].y, cavWorldHeadlightPosition[0].z + 100000.0 * lerp(mwDayBlend * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), cavWorldHeadlightPosition[0].w);   // MW: headlight beams (mwHeadlightScale)
        PixelShaderConstantF[8] = float4(cavWorldHeadlightPosition[1].x, cavWorldHeadlightPosition[1].y, cavWorldHeadlightPosition[1].z + 100000.0 * lerp(mwDayBlend * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), cavWorldHeadlightPosition[1].w);   // MW: headlight beams (mwHeadlightScale)
        PixelShaderConstantF[5] = (cavWorldHeadlightUpDirection[0]);
        PixelShaderConstantF[6] = (cavWorldHeadlightUpDirection[1]);
        PixelShaderConstantF[10] = float4(cfFogEnable, 0, 0, 0);
        PixelShaderConstantF[0] = float4(cmWorldMatTranspose._m00, cmWorldMatTranspose._m10, cmWorldMatTranspose._m20, cmWorldMatTranspose._m30);
        PixelShaderConstantF[1] = float4(cmWorldMatTranspose._m01, cmWorldMatTranspose._m11, cmWorldMatTranspose._m21, cmWorldMatTranspose._m31);
        PixelShaderConstantF[2] = float4(cmWorldMatTranspose._m02, cmWorldMatTranspose._m12, cmWorldMatTranspose._m22, cmWorldMatTranspose._m32);
        PixelShaderConstantF[9] = (cvFogColour);
        PixelShaderConstantF[17] = float4(normalize(lerp(mwSunDirection, cvLocalLightVec.xyz, mwSunSource)), 0);
        PixelShaderConstantF[18] = float4(2.0 * mwDiffuseColour.rgb * mwDayBlend, 0);
        PixelShaderConstantF[19] = float4(1.0 - mwDayBlend, 0, 0, 0);
        PixelShaderConstantF[200] = float4(mwShadowTransform._11, mwShadowTransform._21, mwShadowTransform._31, mwShadowTransform._41);   // MW shadow: mwShadowTransform column 1
        PixelShaderConstantF[201] = float4(mwShadowTransform._12, mwShadowTransform._22, mwShadowTransform._32, mwShadowTransform._42);   // MW shadow: mwShadowTransform column 2
        PixelShaderConstantF[202] = float4(mwShadowTransform._13, mwShadowTransform._23, mwShadowTransform._33, mwShadowTransform._43);   // MW shadow: mwShadowTransform column 3
        PixelShaderConstantF[203] = float4(mwShadowTransform._14, mwShadowTransform._24, mwShadowTransform._34, mwShadowTransform._44);   // MW shadow: mwShadowTransform column 4
        PixelShaderConstantF[211] = float4(-0.4392 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.5509 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.2856 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -1.4897 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 0,1
        PixelShaderConstantF[212] = float4(0.4906 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -1.2961 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 1.1933 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -1.0105 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 2,3
        PixelShaderConstantF[213] = float4(-0.7667 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.7604 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.5808 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.2698 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 4,5
        PixelShaderConstantF[214] = float4(-0.0317 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.0666 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 1.0911 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.4779 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 6,7
        PixelShaderConstantF[215] = float4(-1.1774 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.0025 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, -0.7693 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.7236 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 8,9
        PixelShaderConstantF[216] = float4(0.4341 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.1733 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.4107 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.1123 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 10,11
        PixelShaderConstantF[217] = float4(-0.9191 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 1.3297 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.2672 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.5148 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 12,13
        PixelShaderConstantF[218] = float4(0.344 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.9464 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 1.5024 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness, 0.3408 * mwShadowParams.z * mwShadowParams2.y * mwShadowSoftness);   // MW shadow: tap offsets 14,15
        PixelShaderConstantF[206] = float4(mwShadowBias, saturate(mwShadowStrength * mwShadowParams.x), saturate(mwShadowParams.y - 1.0), mwShadowParams.w);   // MW shadow: bias, strength, manual mode, debug
        PixelShaderConstantF[210] = float4(saturate(mwShadowParams2.x) * saturate(mwShadowParams.x * 1000.0), 0, 0, 0);   // MW shadow: darken ambient (Darkness)
        PixelShaderConstantF[209] = float4(saturate(mwShadowParams.w), saturate(mwShadowParams.w - 1.0), saturate(mwShadowParams.w - 2.0), 0.25);   // MW shadow debug
        Sampler[8] = <mwShadowSampler>;
    }
}

technique lowlod < int shader = 2; >
{
    pass p0
    {
        VertexShader = compile vs_2_0 VS_LowLod();
        PixelShader  = compile ps_2_0 PS_LowLod();
    }
}

technique worldnormalmap_sm2 < int shader = 2; >
