//=============================================================================
//  worldreflect.fx  --  NFS Carbon WorldReflectShader (roads) + MW daytime lighting
//  GENERATED by make_worldreflect.py from the original IDI_WORLDREFLECT_FX. Editing
//  the "MW DAYTIME PARAMETERS" section is fine to edit; other parts are best changed through the generator.
//
//  Loader: CarbonMWVisuals.asi (the game's own d3dx9_30). The engine reads the annotation
//  <int shader> & maps parameters by name -> the interface must match exactly.
//
//  Pixel shader = original Carbon code (4-tap normal map, MISCMAP1 planar reflection,
//  2 headlights + specular, luminance clamp 1.8) + MW inscatter before fog.
//  Vertex shader = replica of the original VS; COLOR.rgb (baked light, originally
//  2*pow(vertexcolor,1.3) = night lights) is blended into MW's 2*(ambient*E + sun).
//
//  SM2/SM1 fallback techniques (index 3..6, renamed *_sm2/_sm1 because d3dx9_43
//  rejects duplicate names) use the same SM3 shaders: on GPUs
//  without SM3 this effect will not be valid (irrelevant for modern PCs).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect: names, types, shared, semantics, order)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
shared float4x4  cmWorldView : REG_cmWorldView;
shared float     cfSurfaceReflection : REG_cfSurfaceReflection;
shared float     cfRainIntensity : REG_cfRainIntensity;
shared float4    cvLocalLightVec : REG_cvLocalLightVec;
float4    cvDiffuseColour : REG_cvDiffuseColour;
float4    cvSpecularColour : REG_cvSpecularColour;
float     cfSpecularPower : REG_cfSpecularPower;
shared float3    cvLocalEyePos : REG_cvLocalEyePos;
shared float     cfMipMapBias : REG_cfMipMapBias;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
texture   MISCMAP1_TEXTURE;
sampler MISCMAP1_SAMPLER = sampler_state
{
    Texture = <MISCMAP1_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
texture   MISCMAP2_TEXTURE;
sampler MISCMAP2_SAMPLER = sampler_state
{
    Texture = <MISCMAP2_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
texture   NORMALMAP_TEXTURE;
sampler NORMALMAP_SAMPLER = sampler_state
{
    Texture = <NORMALMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
shared float4    cvHeadlight1Colour;
shared float4    cvHeadlight2Colour;
shared float4    cavWorldHeadlightDirection[2] : REG_cavWorldHeadlightDirection;
shared float4    cavWorldHeadlightUpDirection[2] : REG_cavWorldHeadlightUpDirection;
shared float4    cavWorldHeadlightPosition[2] : REG_cavWorldHeadlightPosition;
shared texture   HEADLIGHT_TEXTURE;
shared texture   HEADLIGHT_CLIP_TEXTURE;
float4x4  cmHeadlight1WVP : REG_cmHeadlight1WVP;
sampler HEADLIGHT_SAMPLER = sampler_state
{
    Texture = <HEADLIGHT_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   HEADLIGHT_TEXTURE_OLD;
sampler HEADLIGHT_SAMPLER_OLD = sampler_state
{
    Texture = <HEADLIGHT_TEXTURE_OLD>;
    MagFilter = LINEAR;
    MipFilter = NONE;
    MinFilter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};
sampler HEADLIGHT_CLIP_SAMPLER = sampler_state
{
    Texture = <HEADLIGHT_CLIP_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
float     headlight_colour_scale = 0.400000006;

//-----------------------------------------------------------------------------
// SUN SHADOWS (set by CarbonMWVisuals.asi every frame; shared through the effect pool)
//   mwShadowParams: x = strength (0 = off), y = mode (1 = hw depth compare D24S8,
//                   2 = manual DF16 compare), z = 1/map size
//-----------------------------------------------------------------------------
shared texture  mwShadowMap;
shared float4x4 mwShadowTransform;
shared float4   mwShadowParams = float4(0.0, 1.0, 0.0009765625, 0.0);
shared int      mwShadowFilter = 2;   // 2 = LINEAR (hw 2x2 PCF), 1 = POINT (DF16)
shared float4   mwShadowParams2 = float4(0.0, 1.0, 0.0, 0.0);   // x = darken ambient in shadow, y = PCF radius (texels)

float  mwShadowStrength   = 1.0;      // strength multiplier for this shader (main strength: Strength in CarbonMWVisuals.ini)
float  mwShadowBias       = 0.0004;   // ~0.25 m. Raise it if you see shadow acne, lower it if shadows detach from the base of objects
float  mwShadowSoftness   = 1.0;      // PCF radius multiplier (main radius: Softness in CarbonMWVisuals.ini)

sampler mwShadowSampler = sampler_state
{
    Texture   = <mwShadowMap>;
    MinFilter = <mwShadowFilter>;
    MagFilter = <mwShadowFilter>;
    MipFilter = NONE;
    AddressU  = BORDER;
    AddressV  = BORDER;
    BorderColor = 0xFFFFFFFF;
};


//-----------------------------------------------------------------------------
// MW DAYTIME PARAMETERS (defaults; the Carbon engine never touches these)
// Keep equal to world.fx so roads & objects match. Z = up.
//-----------------------------------------------------------------------------
float  mwDayBlend         = 1.0;
float  mwSunSource        = 0.0;
float3 mwSunDirection     = float3(0.35, 0.45, 0.82);
float4 mwDiffuseColour    = float4(0.62, 0.57, 0.48, 1.0);
float4 mwAmbientColour    = float4(0.36, 0.38, 0.42, 1.0);
float3 mwBetaRayleigh     = float3(0.000107, 0.000179, 0.000373);
float3 mwBetaMie          = float3(0.000040, 0.000052, 0.000079);
float  mwMieG             = -0.50;
float  mwInscatterIntensity = 8.1;
float  mwFogDistanceScale = 1.0;
float3 mwInscatterTint    = float3(1.0, 1.0, 1.0);
float  mwSunExtinction    = 0.0;
float  mwBakedLightMix    = 0.0;
float  mwBakedAOStrength  = 0.5;
float  mwBakedAOScale     = 2.0;
float  mwCarbonFogMix     = 0.0;

static const float3 LUMINANCE = float3(0.2125, 0.7154, 0.0721);
static const float  PI        = 3.14159265;

// Camera position (object space) from WorldViewProj (cvLocalEyePos can be stale).
float3 EyeObjectSpace()
{
    float4x4 T = transpose(WorldViewProj);
    float4 a = T[0], b = T[1], c = T[3];
    float3 bc = cross(b.xyz, c.xyz);
    float3 ca = cross(c.xyz, a.xyz);
    float3 ab = cross(a.xyz, b.xyz);
    float  det = dot(a.xyz, bc);
    float3 e = -(a.w * bc + b.w * ca + c.w * ab) / (abs(det) > 1e-20 ? det : 1.0);
    return abs(det) > 1e-20 ? e : cvLocalEyePos;
}

// MW daytime lighting per vertex. Carbon roads: object space == world space
// (the original PS uses headlights & positions directly in world space).
void MWDaylight(float3 wpos, float3 wnrm, float3 vcol, out float3 ambE, out float3 sun, out float3 inscat)
{
    float3 L     = normalize(lerp(mwSunDirection, cvLocalLightVec.xyz, mwSunSource));
    float3 toEye = EyeObjectSpace() - wpos;
    float  dist  = length(toEye);
    float3 V     = toEye / max(dist, 1e-3);
    float  cosT  = dot(L, V);

    float  s     = clamp(dist * mwFogDistanceScale, 0.0, 2500.0);
    float3 BrBm  = mwBetaRayleigh + mwBetaMie;
    float3 E     = exp(-s * BrBm);

    float  g      = mwMieG;
    float  phaseR = 1.0 + cosT * cosT;
    float  phaseM = (1.0 - g) * (1.0 - g) * pow(max(1.0 + g * g - 2.0 * g * cosT, 1e-4), -1.5);
    float3 BrT    = mwBetaRayleigh * (3.0 / (16.0 * PI)) * phaseR;
    float3 BmT    = mwBetaMie * (1.0 / (4.0 * PI)) * phaseM;
    inscat = saturate((BrT + BmT) / BrBm * (1.0 - E) * mwInscatterIntensity) * mwInscatterTint;

    float  ao = lerp(1.0, saturate(dot(vcol, LUMINANCE) * mwBakedAOScale), mwBakedAOStrength);
    float3 vc = lerp(ao.xxx, vcol, mwBakedLightMix);
    ambE = mwAmbientColour.rgb * mwAmbientColour.w * vc * min(E, 1.0);
    sun  = saturate(dot(wnrm, L)) * mwDiffuseColour.rgb * lerp(1.0, min(E, 1.0), mwSunExtinction);
}

float  mwHeadlightScale   = 0.0;    // car headlight beams (player + AI) in daytime:
                                    // 0 = off, > 0 = on like Carbon (this asm shader cannot dim it gradually)
float  mwHeadlightOverride = 0.0;  // 1 = mwHeadlightOn decides the beams (time of day clock), 0 = automatic
float  mwHeadlightOn       = 1.0;  // with mwHeadlightOverride = 1: 1 = beams on, 0 = off

float  mwRoadReflectScale = 0.5;    // planar road reflection in daytime (cars & buildings):
                                    // 0 = off, 1 = like Carbon


//-----------------------------------------------------------------------------
// Vertex shader: replica of the original Carbon VS (vs_3_0 techs dryroad/raining/lowlod)
//-----------------------------------------------------------------------------
struct VS_IN_ROAD
{
    float4 pos  : POSITION;
    float3 nrm  : NORMAL;
    float4 col  : COLOR0;
    float4 uv   : TEXCOORD0;
    float4 tan  : TANGENT;
};

struct VS_OUT_ROAD
{
    float4 pos    : POSITION;
    float4 col    : COLOR0;     // rgb = baked light (replaced by MW), a = asphalt sparkle
    float4 uv     : TEXCOORD0;  // xy = uv, zw = pos.xy * 0.200000003 (rain puddle noise)
    float4 scr    : TEXCOORD1;  // screen coordinates for the planar reflection
    float4 tan    : TEXCOORD2;
    float4 opos   : TEXCOORD3;
    float3 nrm    : TEXCOORD4;
    float  fog    : FOG;
    float3 eye    : TEXCOORD5;
    float3 inscat : TEXCOORD6;  // NEW: MW inscatter (read by the PS through v9)
    float4 sunp   : TEXCOORD7;  // NEW: sun share in COLOR0.rgb (PS: v0) -> reduced in shadow
};

VS_OUT_ROAD VS_Road(VS_IN_ROAD i)
{
    VS_OUT_ROAD o;
    float4 clip = mul(i.pos, WorldViewProj);
    o.pos = clip;

    // asphalt sparkle (original): k = +-0.25, m = signed fmod + 3, hash = frac(2^(m*a) * 2^(m*b))
    float2 p = i.pos.xy;
    float2 k = (p * 0.25 >= -p * 0.25) ? 0.25 : -0.25;
    float2 m = k * frac(p / k) + 3.0;
    float2 h = exp2(m * float2(3.20367098, 2.83257604));
    float  sp = frac(h.x * h.y);

    float3 night = 2.0 * pow(max(i.col.rgb, 1e-6), 1.29999995);
    float3 ambE, sun, inscat;
    MWDaylight(i.pos.xyz, normalize(i.nrm), 0.5 * night, ambE, sun, inscat);
    float3 day = 2.0 * (ambE + sun);
    o.col = float4(lerp(night, day, mwDayBlend), 3.0 * sp * sp);

    // original Carbon fog; daytime: off unless mwCarbonFogMix
    float f   = saturate((cvFogValue.x - clip.z) * cvFogValue.y);
    float fog = 1.0 - pow(1.0 - f, cvFogValue.w) * cvFogValue.z * cfFogEnable;
    o.fog = lerp(fog, 1.0, mwDayBlend * (1.0 - mwCarbonFogMix));

    o.scr  = float4((clip.x + clip.w) * 0.5, (clip.w - clip.y) * 0.5, clip.z, clip.w);
    o.uv   = float4(i.uv.xy, i.pos.xy * 0.200000003);
    o.tan  = i.tan;
    o.opos = i.pos;
    o.nrm  = i.nrm;
    o.eye  = cvLocalEyePos;
    o.inscat = inscat * mwDayBlend;
    // sun share of the total light (luminance). COLOR0 is clamped to 0..1 by the interpolator,
    // so the PS applies shadow as a multiplier: col * (1 - occlusion * share).
    float3 sunc = 2.0 * sun * mwDayBlend;
    o.sunp   = float4(sunc, saturate(dot(sunc, LUMINANCE) / max(dot(o.col.rgb, LUMINANCE), 1e-3)));
    return o;
}

//-----------------------------------------------------------------------------
// Techniques: same names, order & annotations as the original
//-----------------------------------------------------------------------------
technique dryroad < int shader = 3; >
{
    pass p0
    {
        VertexShader = compile vs_3_0 VS_Road();
        PixelShader = asm
        {
            ps_3_0
            def c207, 1, 0, 0.0625, 0
            def c208, -40, 1, 0, 0.001
            def c8, 1, 0, -1.29999995, 0.25
            def c9, 0, -2, 0, -2.17000008
            def c10, 0.25, -0.5, 0.5, 20
            def c11, 0.850000024, 0.588235319, 0.00425531901, 1
            def c12, 7.69999981, 3.70000005, 0.0700000003, 0.200000003
            def c13, -1, 0, 1, 0.100000001
            def c14, 0.5, 0.400000006, 1.70000005, 1
            def c15, 1.5, 0.212500006, 0.715399981, 0.0720999986
            def c16, 1.79999995, 0, 0, 0
            defi i0, 4, 0, 0, 0
            dcl_color_pp v1
            dcl_texcoord_pp v2.xy
            dcl_texcoord1_pp v3.xyw
            dcl_texcoord2_pp v4
            dcl_texcoord3 v5.xyz
            dcl_texcoord4_pp v6.xyz
            dcl_fog_pp v7.x
            dcl_texcoord5 v8.xyz
            dcl_2d s0
            dcl_2d s1
            dcl_2d s2
            dcl_2d s3
            dcl_texcoord6 v9.xyz
            dcl_texcoord7 v0
            dcl_2d s8
            mov r24.xyz, v5                  // MW shadow: world position
            mov r24.w, c207.x
            dp4 r25.x, r24, c200
            dp4 r25.y, r24, c201
            dp4 r25.z, r24, c202
            dp4 r25.w, r24, c203
            add r28.y, r25.w, -c208.w              // MW shadow: w <= 0 -> outside the map
            cmp r28.y, r28.y, c207.y, c207.x
            max r25.w, r25.w, c208.w
            rcp r25.w, r25.w
            mul r24.xyz, r25, r25.w              // MW shadow: shadow map coordinates
            add r24.z, r24.z, -c206.x             // MW shadow: - bias
            mov r24.w, c207.x
            mov r25.zw, r24                     // MW shadow: tap group 0
            add r25.xy, r24, c211
            texldp r26, r25, s8
            add r25.xy, r24, c211.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c212
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c212.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r28.w, r25, c207.z
            mov r25.zw, r24                     // MW shadow: tap group 1
            add r25.xy, r24, c213
            texldp r26, r25, s8
            add r25.xy, r24, c213.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c214
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c214.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.zw, r24                     // MW shadow: tap group 2
            add r25.xy, r24, c215
            texldp r26, r25, s8
            add r25.xy, r24, c215.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c216
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c216.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.zw, r24                     // MW shadow: tap group 3
            add r25.xy, r24, c217
            texldp r26, r25, s8
            add r25.xy, r24, c217.zwzw
            texldp r27, r25, s8
            mov r26.y, r27.x
            add r25.xy, r24, c218
            texldp r27, r25, s8
            mov r26.z, r27.x
            add r25.xy, r24, c218.zwzw
            texldp r27, r25, s8
            mov r26.w, r27.x
            add r27, r26, -r24.z
            cmp r27, r27, c207.x, c207.y
            lrp r25, c206.z, r27, r26
            dp4 r25.x, r25, c207.z
            add r28.w, r28.w, r25.x
            mov r25.x, r28.w                    // MW shadow: average of 16 taps
            mad r27.xy, r24, -r24, r24
            min r27.x, r27.x, r27.y
            mad_sat r25.y, r27.x, c208.x, c208.y    // MW shadow: fade at the map edge 1 - min*40
            cmp r27.x, r27.x, c207.y, c207.x         // MW shadow: outside the map = lit
            add r27.x, r27.x, r28.y
            add r25.x, r25.x, r25.y
            add_sat r25.x, r25.x, r27.x
            add r25.x, -r25.x, c207.x
            mul r28.x, r25.x, c206.y              // MW shadow: occlusion * strength
            mul r28.z, r25.x, c210.x               // MW shadow: ambient occlusion * Darkness
            mul r25.x, v0.w, r28.x                 // MW shadow: sun occlusion x sun share
            add r25.y, c207.x, -v0.w               // ambient share
            mad r25.x, r25.y, r28.z, r25.x         // + ambient occlusion (Darkness) x ambient share
            add r25.x, -r25.x, c207.x
            mul r29.xyz, v1, r25.x
            mov r29.w, v1.w
            mov r25.w, r26.x                    // MW shadow debug: raw sample of tap 0
            mov_sat r26.xy, r24                 // debug 1: R = x, G = y, B = occlusion
            mov_sat r26.z, r28.x
            lrp r27.xyz, c209.y, r25.w, r26         // debug 2: raw value (grey)
            mul r26.xyz, v5, c209.w               // debug 3: 4 m checkerboard from the world position
            frc r26.xyz, r26
            lrp r25.xyz, c209.z, r26, r27
            lrp r26.xyz, c209.x, r25, r29
            mov r29.xyz, r26
            dsx_pp r1.xy, v2
            dsy_pp r2.xy, v2
            max_pp r0.x, r2_abs.x, r1_abs.x
            max_pp r0.y, r1_abs.y, r2_abs.y
            mul_pp r2.xy, r0, c8.w
            mov_pp r0.xyz, c8.y
            mov r0.w, c8.y
            rep i0
            add r1.w, r0.w, c9.y
            mad_pp r1.xy, r1.w, r2, v2
            mov r1.zw, c9
            texldb_pp r1, r1, s2
            add_pp r0.xyz, r0, r1
            add r0.w, r0.w, c8.x
            endrep 
            mov_pp r1.xyz, v6
            mul_pp r2.xyz, r1.zxyw, v4.yzxw
            mad_pp r0.xyz, r0, c10.x, c10.y
            mad_pp r1.xyz, r1.yzxw, v4.zxyw, -r2
            add_pp r0.xyz, r0, r0
            mul_pp r1.xyz, r1, v4.w
            mul_pp r1.xyz, r0.y, r1
            mad_pp r1.xyz, v4, r0.x, r1
            mad_pp r3.xyz, v6, r0.z, r1
            mad_pp r2.x, r3.x, c10.z, v3.x
            rcp_pp r0.w, v3.w
            add r0.z, -v5.z, c5.z
            mov r0.xy, c5
            mad r1.xyz, v5.xyxw, c13.xxyw, c13.yyzw
            mov_pp r2.y, v3.y
            add r0.xyz, r0, r1
            mul_pp r7.xy, r2, r0.w
            dp3 r0.w, r0, r0
            mul_pp r5.w, r29.w, c7.x
            rsq r0.w, r0.w
            mul r4.xyz, r0, r0.w
            rcp r0.z, r0.w
            dp3_sat r0.w, r4, r3
            mad_sat r0.z, r0.z, -c11.z, c11.w
            mul r0.z, r0.z, c222.x            // MW: headlight beams (mwHeadlightScale)
            mul r0.y, r0.z, r0.z
            dp3_sat r0.z, r4, -c1
            mul_pp r2.w, r0.y, c12.x
            pow_pp r1.w, r0.z, c12.y
            add r0.z, -v5.z, c4.z
            mov r0.xy, c4
            mul_pp r3.w, r2.w, r1.w
            add r0.xyz, r1, r0
            add r1.w, r0.w, c12.z
            dp3 r0.w, r0, r0
            mul r4.w, r3.w, r1.w
            rsq r0.w, r0.w
            mul r6.xyz, r0, r0.w
            rcp r0.z, r0.w
            dp3_sat r0.w, r6, r3
            mad_sat r0.z, r0.z, -c11.z, c11.w
            mul r0.z, r0.z, c222.x            // MW: headlight beams (mwHeadlightScale)
            mul r0.z, r0.z, r0.z
            dp3_sat r1.w, r6, -c0
            mul_pp r0.y, r0.z, c12.x
            pow_pp r0.z, r1.w, c12.y
            mul_pp r2.w, r0.y, r0.z
            add r0.w, r0.w, c12.z
            mul r1.w, r2.w, r0.w
            dp3 r0.w, r6, c2
            add r0.w, r0.w, c11.x
            mov_pp r0.xyz, c1
            mul_pp r1.xyz, r0.zxyw, c3.yzxw
            mul_pp r5.y, r0.w, c11.y
            mad_pp r0.xyz, r0.yzxw, c3.zxyw, -r1
            dp3 r0.z, r4, -r0
            dp3 r0.w, r4, c3
