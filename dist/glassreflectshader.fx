//=============================================================================
//  glassreflectshader.fx  --  NFS Carbon GlassReflect (building glass), original shader
//  GENERATED by make_glassreflect.py from the original IDI_GLASSREFLECTSHADER_FX.
//  Only change: car headlight beams (projected onto the glass) can be switched off
//  through mwHeadlightScale (0 = off). Annotation <int shader> = original value (REQUIRED).
//=============================================================================

//-----------------------------------------------------------------------------
// CARBON INTERFACE (generated from the original effect)
//-----------------------------------------------------------------------------
shared float4x4  WorldViewProj;
shared float4x4  cmWorldViewProj : REG_cmWorldViewProj;
shared int       ColorWriteMode;
shared int       Cull_Mode;
shared int       BaseMinTextureFilter;
shared int       BaseMagTextureFilter;
shared int       BaseMipTextureFilter;
shared int       BaseTextureFilterParam;
shared int       BaseAddressU;
shared int       BaseAddressV;
shared float     FocalRange;
shared float4    cvFogColour;
shared int       FogColor;
shared float4    cvFogValue;
float4x4  LocalWorld;
float     cfFogEnable : REG_cfFogEnable;
shared float4    cvVertexPowerBrightness : REG_cvVertexPowerBrightness;
shared float4x4  cmWorldView : REG_cmWorldView;
shared float4x4  cmWorldMat : REG_cmWorldMat;
shared float4x4  cmWorldMatTranspose : REG_cmWorldMatTranspose;
shared float4    cvDiffuseColour : REG_cvDiffuseColour;
shared float3    cvLocalEyePos : REG_cvLocalEyePos;
shared float4    cvLocalLightVec : REG_cvLocalLightVec;
float4x4  cmLocalDirectionMatrix : REG_cmLocalDirectionMatrix;
texture   DIFFUSEMAP_TEXTURE;
sampler DIFFUSEMAP_SAMPLER = sampler_state
{
    Texture = <DIFFUSEMAP_TEXTURE>;
    AddressU = WRAP;
    AddressV = WRAP;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
texture   ENVIROMAP_TEXTURE;
samplerCUBE ENVIROMAP_SAMPLER = sampler_state
{
    Texture = <ENVIROMAP_TEXTURE>;
    AddressU = MIRROR;
    AddressV = MIRROR;
    MipFilter = <BaseMipTextureFilter>;
    MinFilter = <BaseMinTextureFilter>;
    MagFilter = <BaseMagTextureFilter>;
    MaxAnisotropy = <BaseTextureFilterParam>;
};
shared float4    cvHeadlight1Colour;
shared float4    cvHeadlight2Colour;
shared float4    cavWorldHeadlightDirection[2] : REG_cavWorldHeadlightDirection;
shared float4    cavWorldHeadlightUpDirection[2] : REG_cavWorldHeadlightUpDirection;
shared float4    cavWorldHeadlightPosition[2] : REG_cavWorldHeadlightPosition;
shared texture   HEADLIGHT_TEXTURE;
shared texture   HEADLIGHT_CLIP_TEXTURE;
float4x4  cmHeadlight1WVP : REG_cmHeadlight1WVP;
sampler HEADLIGHT_SAMPLER = sampler_state
{
    Texture = <HEADLIGHT_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
texture   HEADLIGHT_TEXTURE_OLD;
sampler HEADLIGHT_SAMPLER_OLD = sampler_state
{
    Texture = <HEADLIGHT_TEXTURE_OLD>;
    MagFilter = LINEAR;
    MipFilter = NONE;
    MinFilter = LINEAR;
    AddressU = CLAMP;
    AddressV = CLAMP;
};
sampler HEADLIGHT_CLIP_SAMPLER = sampler_state
{
    Texture = <HEADLIGHT_CLIP_TEXTURE>;
    AddressU = CLAMP;
    AddressV = CLAMP;
    MipFilter = NONE;
    MinFilter = LINEAR;
    MagFilter = LINEAR;
};
float  mwHeadlightScale   = 0.0;    // car headlight beams (player + AI) in daytime:
                                    // 0 = off, > 0 = on like Carbon (this asm shader cannot dim it gradually)
float  mwHeadlightOverride = 0.0;  // 1 = mwHeadlightOn decides the beams (time of day clock), 0 = automatic
float  mwHeadlightOn       = 1.0;  // with mwHeadlightOverride = 1: 1 = beams on, 0 = off

//-----------------------------------------------------------------------------
// Techniques: same order & annotations as the original
//-----------------------------------------------------------------------------
technique glassreflect < int shader = 3; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_3_0
            def c12, 1, 0, 0, 0
            dcl_position v0
            dcl_normal v1
            dcl_color v2
            dcl_texcoord v3
            dcl_position o0
            dcl_color o1
            dcl_texcoord o2
            dcl_texcoord1 o3.xyz
            dcl_texcoord2 o4.xyz
            dcl_texcoord3 o5
            dcl_fog o6.x
            mov r0.x, c4.x
            mov r0.z, c5.x
            mov r0.y, c6.x
            dp4 o0.x, v0, c0
            dp3 r0.w, r0, r0
            dp4 o0.y, v0, c1
            rsq r0.w, r0.w
            dp4 o0.w, v0, c3
            mul r2.xyz, r0, r0.w
            mov r0.x, c4.y
            mov r0.z, c5.y
            mov r0.y, c6.y
            dp4 r0.w, v1, v1
            rsq r0.w, r0.w
            add r4.xyz, c11, -v0
            mul r3.xyz, r0.w, v1
            nrm r1.xyz, r4
            dp3 r1.w, r0, r0
            dp3 r0.w, r3, r1
            rsq r1.w, r1.w
            add r0.w, r0.w, r0.w
            mul r0.xyz, r0, r1.w
            mad r1.xyz, r1, -r0.w, r3
            mul r4.xyz, r2.yzxw, r0.zxyw
            mul r3.xyz, r0, r1.y
            mad r0.xyz, r2.zxyw, r0.yzxw, -r4
            mad r2.xyz, r2, r1.x, r3
            mad o3.xyz, r0, r1.z, r2
            dp4 o5.x, c4, v0
            dp4 o5.y, c5, v0
            dp4 o5.z, c6, v0
            dp4 o5.w, c7, v0
            dp4 r1.y, v0, c2
            log r0.x, v2.x
            log r0.y, v2.y
            log r0.z, v2.z
            add r0.w, -r1.y, c8.x
            mul r0.xyz, r0, c10.x
            mul_sat r0.w, r0.w, c8.y
            exp r0.x, r0.x
            exp r0.y, r0.y
            exp r0.z, r0.z
            add r1.w, -r0.w, c12.x
            mul o1.xyz, r0, c10.y
            pow r0.w, r1.w, c8.w
            mov o0.z, r1.y
            mul r0.w, r0.w, c8.z
            mov r0.z, c12.x
            mad o6.x, r0.w, -c9.x, r0.z
            mov o1.w, v2.w
            mov o2, v3.xyxy
            mov o4.xyz, v1
        };
        VertexShaderConstantF[0] = float4(WorldViewProj._m00, WorldViewProj._m10, WorldViewProj._m20, WorldViewProj._m30);
        VertexShaderConstantF[1] = float4(WorldViewProj._m01, WorldViewProj._m11, WorldViewProj._m21, WorldViewProj._m31);
        VertexShaderConstantF[2] = float4(WorldViewProj._m02, WorldViewProj._m12, WorldViewProj._m22, WorldViewProj._m32);
        VertexShaderConstantF[3] = float4(WorldViewProj._m03, WorldViewProj._m13, WorldViewProj._m23, WorldViewProj._m33);
        VertexShaderConstantF[9] = float4(cfFogEnable, 0, 0, 0);
        VertexShaderConstantF[4] = float4(cmWorldMat._m00, cmWorldMat._m10, cmWorldMat._m20, cmWorldMat._m30);
        VertexShaderConstantF[5] = float4(cmWorldMat._m01, cmWorldMat._m11, cmWorldMat._m21, cmWorldMat._m31);
        VertexShaderConstantF[6] = float4(cmWorldMat._m02, cmWorldMat._m12, cmWorldMat._m22, cmWorldMat._m32);
        VertexShaderConstantF[7] = float4(cmWorldMat._m03, cmWorldMat._m13, cmWorldMat._m23, cmWorldMat._m33);
        VertexShaderConstantF[8] = (cvFogValue);
        VertexShaderConstantF[11] = float4(cvLocalEyePos, 0);
        VertexShaderConstantF[10] = (cvVertexPowerBrightness);
        PixelShader = asm
        {
            ps_3_0
            def c10, 0.00425531901, 1, 3.5, 5.69999981
            def c11, 2.70000005, 0.5, -0.400000006, 2.47000003
            def c12, -0, 2, 0, 0
            dcl_color_pp v1.xyz
            dcl_texcoord_pp v2.xy
            dcl_texcoord1_pp v3.xyz
            dcl_texcoord2_pp v4.xyz
            dcl_texcoord3 v5.xyz
            dcl_fog_pp v6.x
            dcl_2d s0
            dcl_cube s1
            dcl_2d s2
            add r0.xyz, -v5, c6
            dp3 r0.w, r0, r0
            rsq r1.w, r0.w
            rcp r0.w, r1.w
            mad_sat r0.w, r0.w, -c10.x, c10.y
            mul r0.w, r0.w, c222.x            // MW: headlight beams (mwHeadlightScale)
            mul r0.xyz, r0, r1.w
            mul r0.w, r0.w, r0.w
            mul_pp r1.w, r0.w, c10.z
            mul r1.xyz, v4.y, c1
            dp3_sat r2.w, r0, -c4
            mad r1.xyz, c0, v4.x, r1
            pow_pp r0.w, r2.w, c10.w
            mad_pp r3.xyz, c2, v4.z, r1
            mul_pp r2.w, r1.w, r0.w
            dp3 r0.w, r0, r3
            min_pp r1.w, r2.w, c11.x
            abs_sat r0.w, r0.w
            mul r1.w, r1.w, r0.w
            dp3 r0.w, r0, c9
            add r2.w, -r0_abs.w, c10.y
            add r0.w, r0.w, c10.y
            mul r3.w, r2.w, r2.w
            mov r2.xyz, c9
            mul_pp r1.xyz, r2.yzxw, c4.zxyw
            mad_sat_pp r2.w, r2.w, r3.w, c11.z
            mad_pp r1.xyz, c4.yzxw, r2.zxyw, -r1
            mul_pp r2.w, r2.w, c11.w
            dp3 r0.z, r0, -r1
            mul r1.z, r1.w, r2.w
            add r0.z, r0.z, c10.y
            mul_pp r0.x, r0.z, c11.y
            mul_pp r0.y, r0.w, c11.y
            texld r0, r0, s2
            add r4.xyz, -v5, c5
            dp3 r0.w, r4, r4
            rsq r1.w, r0.w
            mul_pp r1.xyz, r1.z, r0
            rcp r0.w, r1.w
            mul r0.xyz, r4, r1.w
            mad_sat r0.w, r0.w, -c10.x, c10.y
            mul r0.w, r0.w, c222.x            // MW: headlight beams (mwHeadlightScale)
            mul r0.w, r0.w, r0.w
            dp3_sat r2.w, r0, -c3
            mul_pp r1.w, r0.w, c10.z
            pow_pp r0.w, r2.w, c10.w
            mul_pp r2.w, r1.w, r0.w
            dp3 r0.w, r0, r3
            min_pp r1.w, r2.w, c11.x
            abs_sat r0.w, r0.w
            mul r1.w, r1.w, r0.w
            dp3 r0.w, r0, c9
            add r2.w, -r0_abs.w, c10.y
            add r0.w, r0.w, c10.y
            mul r3.w, r2.w, r2.w
            mul_pp r3.xyz, r2.yzxw, c3.zxyw
            mad_sat_pp r2.w, r2.w, r3.w, c11.z
            mad_pp r2.xyz, c3.yzxw, r2.zxyw, -r3
            mul_pp r2.w, r2.w, c11.w
            dp3 r0.z, r0, -r2
            mul r1.w, r1.w, r2.w
            add r0.z, r0.z, c10.y
            mul_pp r0.x, r0.z, c11.y
            mul_pp r0.y, r0.w, c11.y
            texld r0, r0, s2
            mad_pp r0.xyz, r1.w, r0, r1
            max_pp r1.xyz, r0, c12.x
            min_pp r0.xyz, r1, c12.y
            mad_pp r0.xyz, c8.x, r0, v1
            texld_pp r3, v2, s0
            mul_pp r3.xyz, r0, r3
            texld_pp r2, v3, s1
            mov_sat_pp r1.w, r3.w
            lrp_pp r0, r1.w, r2, r3
            add_pp r0.xyz, r0, -c7
            mov_pp oC0.w, r0.w
            mad_pp oC0.xyz, v6.x, r0, c7
        };
        PixelShaderConstantF[222] = float4(1.0 - lerp(1.0 * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), 0, 0, 0);   // MW: headlight beams
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <ENVIROMAP_SAMPLER>;
        Sampler[2] = <HEADLIGHT_SAMPLER>;
        PixelShaderConstantF[3] = (cavWorldHeadlightDirection[0]);
        PixelShaderConstantF[4] = (cavWorldHeadlightDirection[1]);
        PixelShaderConstantF[5] = float4(cavWorldHeadlightPosition[0].x, cavWorldHeadlightPosition[0].y, cavWorldHeadlightPosition[0].z + 100000.0 * lerp(1.0 * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), cavWorldHeadlightPosition[0].w);   // MW: headlight beams (mwHeadlightScale)
        PixelShaderConstantF[6] = float4(cavWorldHeadlightPosition[1].x, cavWorldHeadlightPosition[1].y, cavWorldHeadlightPosition[1].z + 100000.0 * lerp(1.0 * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), cavWorldHeadlightPosition[1].w);   // MW: headlight beams (mwHeadlightScale)
        PixelShaderConstantF[9] = (cavWorldHeadlightUpDirection[0]);
        PixelShaderConstantF[8] = float4(cfFogEnable, 0, 0, 0);
        PixelShaderConstantF[0] = float4(cmWorldMatTranspose._m00, cmWorldMatTranspose._m10, cmWorldMatTranspose._m20, cmWorldMatTranspose._m30);
        PixelShaderConstantF[1] = float4(cmWorldMatTranspose._m01, cmWorldMatTranspose._m11, cmWorldMatTranspose._m21, cmWorldMatTranspose._m31);
        PixelShaderConstantF[2] = float4(cmWorldMatTranspose._m02, cmWorldMatTranspose._m12, cmWorldMatTranspose._m22, cmWorldMatTranspose._m32);
        PixelShaderConstantF[7] = (cvFogColour);
    }
}

technique lowlod < int shader = 2; >
{
    pass p0
    {
        VertexShader = asm
        {
            vs_1_1
            dcl_position v0
            dcl_color v1
            dcl_texcoord v2
            dp4 oPos.x, v0, c0
            mov r0.xy, v1.x
            mov r0.zw, c4.x
            dp4 oPos.y, v0, c1
            lit r0, r0
            dp4 oPos.z, v0, c2
            mov r0.x, r0.z
            mov r2.xy, v1.y
            mov r2.zw, c4.x
            mov r1.xy, v1.z
            mov r1.zw, c4.x
            lit r2, r2
            lit r1, r1
            mov r0.y, r2.z
            mov r0.z, r1.z
            dp4 oPos.w, v0, c3
            mul oD0.xyz, r0, c4.y
            mov oD0.w, v1.w
            mov oT0.xy, v2
        };
        VertexShaderConstantF[0] = float4(WorldViewProj._m00, WorldViewProj._m10, WorldViewProj._m20, WorldViewProj._m30);
        VertexShaderConstantF[1] = float4(WorldViewProj._m01, WorldViewProj._m11, WorldViewProj._m21, WorldViewProj._m31);
        VertexShaderConstantF[2] = float4(WorldViewProj._m02, WorldViewProj._m12, WorldViewProj._m22, WorldViewProj._m32);
        VertexShaderConstantF[3] = float4(WorldViewProj._m03, WorldViewProj._m13, WorldViewProj._m23, WorldViewProj._m33);
        VertexShaderConstantF[4] = (cvVertexPowerBrightness);
        PixelShader = asm
        {
            ps_2_0
            def c0, 1, 0, 0, 0
            dcl v0.xyz
            dcl_pp t0.xy
            dcl_2d s0
            texld_pp r0, t0, s0
            mul_pp r0.xyz, r0, v0
            mov_pp r0.w, c0.x
            mov_pp oC0, r0
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
    }
}

technique glassreflect_sm2 < int shader = 2; >
{
    pass p0
    {
        FogEnable = <cfFogEnable>;
        FogColor = <FogColor>;
        VertexShader = asm
        {
            vs_2_0
            def c12, 0, 1, 0, 0
            dcl_position v0
            dcl_normal v1
            dcl_color v2
            dcl_texcoord v3
            mov r0.x, c4.x
            mov r0.z, c5.x
            mov r0.y, c6.x
            dp4 oPos.x, v0, c0
            dp4 oPos.y, v0, c1
            dp4 oPos.w, v0, c3
            nrm r2.xyz, r0
            mov r0.x, c4.y
            mov r0.z, c5.y
            mov r0.y, c6.y
            dp4 r0.w, v1, v1
            rsq r0.w, r0.w
            add r4.xyz, -v0, c11
            mul r3.xyz, r0.w, v1
            nrm r1.xyz, r4
            dp3 r5.x, r0, r0
            dp3 r4.x, r3, r1
            rsq r1.w, r5.x
            add r0.w, r4.x, r4.x
            mul r0.xyz, r1.w, r0
            mad r1.xyz, r1, -r0.w, r3
            mul r4.xyz, r2.yzxw, r0.zxyw
            mul r3.xyz, r0, r1.y
            mad r0.xyz, r2.zxyw, r0.yzxw, -r4
            mad r2.xyz, r2, r1.x, r3
            mad oT1.xyz, r0, r1.z, r2
            dp4 oT3.x, c4, v0
            dp4 oT3.y, c5, v0
            dp4 oT3.z, c6, v0
            mov r0.xy, v2.x
            mov r0.zw, c10.x
            dp4 oT3.w, c7, v0
            lit r1, r0
            mov r0.xy, v2.y
            mov r0.zw, c10.x
            mov r1.x, r1.z
            lit r0, r0
            mov r1.y, r0.z
            dp4 r2.y, v0, c2
            mov r0.xy, v2.z
            add r1.w, -r2.y, c8.x
            mov r0.zw, c10.x
            mul r1.w, r1.w, c8.y
            lit r0, r0
            max r0.w, r1.w, c12.x
            mov r1.z, r0.z
            min r0.w, r0.w, c12.y
            add r0.xy, -r0.w, c12.y
            mov r0.zw, c8.w
            mul oD0.xyz, r1, c10.y
            lit r0, r0
            mov oPos.z, r2.y
            mul r0.w, r0.z, c8.z
            mov r0.z, c12.y
            mad oFog, r0.w, -c9.x, r0.z
            mov oD0.w, v2.w
            mov oT0, v3.xyxy
            mov oT2.xyz, v1
        };
        VertexShaderConstantF[0] = float4(WorldViewProj._m00, WorldViewProj._m10, WorldViewProj._m20, WorldViewProj._m30);
        VertexShaderConstantF[1] = float4(WorldViewProj._m01, WorldViewProj._m11, WorldViewProj._m21, WorldViewProj._m31);
        VertexShaderConstantF[2] = float4(WorldViewProj._m02, WorldViewProj._m12, WorldViewProj._m22, WorldViewProj._m32);
        VertexShaderConstantF[3] = float4(WorldViewProj._m03, WorldViewProj._m13, WorldViewProj._m23, WorldViewProj._m33);
        VertexShaderConstantF[9] = float4(cfFogEnable, 0, 0, 0);
        VertexShaderConstantF[4] = float4(cmWorldMat._m00, cmWorldMat._m10, cmWorldMat._m20, cmWorldMat._m30);
        VertexShaderConstantF[5] = float4(cmWorldMat._m01, cmWorldMat._m11, cmWorldMat._m21, cmWorldMat._m31);
        VertexShaderConstantF[6] = float4(cmWorldMat._m02, cmWorldMat._m12, cmWorldMat._m22, cmWorldMat._m32);
        VertexShaderConstantF[7] = float4(cmWorldMat._m03, cmWorldMat._m13, cmWorldMat._m23, cmWorldMat._m33);
        VertexShaderConstantF[8] = (cvFogValue);
        VertexShaderConstantF[11] = float4(cvLocalEyePos, 0);
        VertexShaderConstantF[10] = (cvVertexPowerBrightness);
        PixelShader = asm
        {
            ps_2_0
            def c7, 0.00425531901, 1, 3.5, 5.69999981
            def c8, 2.70000005, 0.5, -0.400000006, 2.47000003
            def c9, -0, 2, 0, 0
            dcl v0.xyz
            dcl_pp t0.xy
            dcl_pp t1.xyz
            dcl_pp t2.xyz
            dcl t3.xyz
            dcl_2d s0
            dcl_cube s1
            dcl_2d s2
            add r0.xyz, -t3, c6
            dp3 r1.x, r0, r0
            rsq r1.w, r1.x
            rcp r0.w, r1.w
            mul r0.xyz, r0, r1.w
            mad_sat r0.w, r0.w, -c7.x, c7.y
            mul r0.w, r0.w, c31.x            // MW: headlight beams (mwHeadlightScale)
            mul r0.w, r0.w, r0.w
            dp3_sat r2.x, r0, -c4
            mul_pp r1.w, r0.w, c7.z
            mul r1.xyz, t2.y, c1
            pow_pp r0.w, r2.x, c7.w
            mad r1.xyz, c0, t2.x, r1
            mul_pp r0.w, r1.w, r0.w
            mad_pp r1.xyz, c2, t2.z, r1
            min_pp r1.w, r0.w, c8.x
            dp3 r1.x, r0, r1
            abs_sat r0.w, r1.x
            mul r1.w, r1.w, r0.w
            dp3 r1.x, r0, c5
            abs r2.w, r1.x
            add r0.w, r1.x, c7.y
            add r2.w, -r2.w, c7.y
            mov_pp r1.xyz, c4
            mul_pp r2.xyz, r1.zxyw, c5.yzxw
            mul r3.w, r2.w, r2.w
            mad_pp r1.xyz, r1.yzxw, c5.zxyw, -r2
            mad_sat_pp r2.w, r2.w, r3.w, c8.z
            dp3 r0.x, r0, -r1
            add r3.w, r0.x, c7.y
            mul_pp r2.w, r2.w, c8.w
            mul_pp r0.x, r3.w, c8.y
            mul r1.w, r1.w, r2.w
            mul_pp r0.y, r0.w, c8.y
            texld r0, r0, s2
            texld_pp r3, t0, s0
            texld_pp r2, t1, s1
            mul_pp r0.xyz, r1.w, r0
            max_pp r1.xyz, r0, c9.x
            min_pp r0.xyz, r1, c9.y
            mad_pp r0.xyz, c3.x, r0, v0
            mov_sat_pp r1.w, r3.w
            mul_pp r3.xyz, r3, r0
            lrp_pp r0, r1.w, r2, r3
            mov_pp oC0, r0
        };
        PixelShaderConstantF[31] = float4(1.0 - lerp(1.0 * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), 0, 0, 0);   // MW: headlight beams
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <ENVIROMAP_SAMPLER>;
        Sampler[2] = <HEADLIGHT_SAMPLER>;
        PixelShaderConstantF[4] = (cavWorldHeadlightDirection[0]);
        PixelShaderConstantF[6] = float4(cavWorldHeadlightPosition[0].x, cavWorldHeadlightPosition[0].y, cavWorldHeadlightPosition[0].z + 100000.0 * lerp(1.0 * saturate(1.0 - mwHeadlightScale * 1000.0), 1.0 - mwHeadlightOn, mwHeadlightOverride), cavWorldHeadlightPosition[0].w);   // MW: headlight beams (mwHeadlightScale)
        PixelShaderConstantF[5] = (cavWorldHeadlightUpDirection[0]);
        PixelShaderConstantF[3] = float4(cfFogEnable, 0, 0, 0);
        PixelShaderConstantF[0] = float4(cmWorldMatTranspose._m00, cmWorldMatTranspose._m10, cmWorldMatTranspose._m20, cmWorldMatTranspose._m30);
        PixelShaderConstantF[1] = float4(cmWorldMatTranspose._m01, cmWorldMatTranspose._m11, cmWorldMatTranspose._m21, cmWorldMatTranspose._m31);
        PixelShaderConstantF[2] = float4(cmWorldMatTranspose._m02, cmWorldMatTranspose._m12, cmWorldMatTranspose._m22, cmWorldMatTranspose._m32);
    }
}

technique glassreflect_sm1 < int shader = 1; >
{
    pass p0
    {
        FogEnable = <cfFogEnable>;
        FogColor = <FogColor>;
        CullMode = <Cull_Mode>;
        VertexShader = asm
        {
            vs_1_1
            def c8, 0, 1, 0, 0
            dcl_position v0
            dcl_normal v1
            dcl_color v2
            dcl_texcoord v3
            dp4 oPos.x, v0, c0
            dp4 oPos.y, v0, c1
            mov r0.xy, v2.x
            mov r0.zw, c6.x
            dp4 oPos.w, v0, c3
            lit r0, r0
            mov r1.xy, v2.y
            mov r1.zw, c6.x
            mov r0.x, r0.z
            lit r2, r1
            mov r1.xy, v2.z
            mov r1.zw, c6.x
            mov r0.y, r2.z
            lit r1, r1
            mov r0.z, r1.z
            dp4 r1.y, v0, c2
            mul oD0.xyz, r0, c6.y
            add r0.w, -r1.y, c4.x
            mov oPos.z, r1.y
            mul r0.w, r0.w, c4.y
            max r0.w, r0.w, c8.x
            add r1.xyz, -v0, c7
            min r0.w, r0.w, c8.y
            dp3 r2.x, r1, r1
            add r0.xy, -r0.w, c8.y
            rsq r1.w, r2.x
            mov r0.zw, c4.w
            mul r1.xyz, r1, r1.w
            lit r0, r0
            dp3 r0.x, r1, v1
            mul r1.w, r0.z, c4.z
            add r0.w, r0.x, r0.x
            mov r0.z, c8.y
            mad oFog, r1.w, -c5.x, r0.z
            mad r0.xyz, v1, -r0.w, r1
            mov oT0.xy, v3
            mov r0.w, -r0.z
            mov oD0.w, v2.w
            mov oT1.xyz, r0.xwyw
        };
        VertexShaderConstantF[0] = float4(WorldViewProj._m00, WorldViewProj._m10, WorldViewProj._m20, WorldViewProj._m30);
        VertexShaderConstantF[1] = float4(WorldViewProj._m01, WorldViewProj._m11, WorldViewProj._m21, WorldViewProj._m31);
        VertexShaderConstantF[2] = float4(WorldViewProj._m02, WorldViewProj._m12, WorldViewProj._m22, WorldViewProj._m32);
        VertexShaderConstantF[3] = float4(WorldViewProj._m03, WorldViewProj._m13, WorldViewProj._m23, WorldViewProj._m33);
        VertexShaderConstantF[5] = float4(cfFogEnable, 0, 0, 0);
        VertexShaderConstantF[4] = (cvFogValue);
        VertexShaderConstantF[7] = float4(cvLocalEyePos, 0);
        VertexShaderConstantF[6] = (cvVertexPowerBrightness);
        PixelShader = asm
        {
            ps_1_1
            tex t0
            tex t1
            mov_sat r0.w, t0.w
            mul t0.xyz, t0, v0
            lrp r0, r0.w, t1, t0
        };
        Sampler[0] = <DIFFUSEMAP_SAMPLER>;
        Sampler[1] = <ENVIROMAP_SAMPLER>;
    }
}
